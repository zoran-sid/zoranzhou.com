---
import GardenGlyph from "./GardenGlyph.astro";
import { getCollection } from "astro:content";
import ArrowIcon from "./ArrowIcon.astro";
import MediaCard from "./media/MediaCard.astro";
import {
  isRouteVisible,
  normalizeRouteEntries,
  formatDistance,
  formatDuration,
} from "../lib/routes/content";
import { entryPath } from "../lib/writing";
import mediaSource from "../content/media.md?raw";
import { parseMediaList } from "../lib/media/list";
import { localizePath, type Locale } from "../i18n/utils";
import "../styles/media.css";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const zh = locale === "zh-CN";
const routes = normalizeRouteEntries(
  await getCollection("routes", ({ data }) => isRouteVisible(data)),
)
  .filter((entry) => entry.data.lang === locale && entry.data.kind === "run")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const films = parseMediaList(mediaSource)
  .filter((item) => item.category === "movies" && item.status === "watched")
  .slice(0, 3);
const date = new Intl.DateTimeFormat(zh ? "zh-CN" : "en-GB", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "Asia/Shanghai",
});
---

<div class="page-container home-activities editorial-section">
  {
    routes.length > 0 && (
      <section
        class="running-log"
        id="running"
        aria-labelledby="running-heading"
      >
        <header class="section-head">
          <div>
            <>
              <h2 id="running-heading">
                {zh ? "在路中去感受" : "Life along the way"}
              </h2>
              <p>
                {zh
                  ? "公园里的日常，也有出发线上的清晨。"
                  : "Everyday park runs and mornings on the starting line."}
              </p>
            </>
          </div>
        </header>
        <ol class="running-list">
          {routes.map((entry) => (
            <li>
              <a href={entryPath(entry)}>
                <GardenGlyph class="running-symbol" />
                <time datetime={entry.data.date.toISOString()}>
                  {date.format(entry.data.date)}
                </time>
                <div class="running-list__title">
                  <h3>{entry.data.title}</h3>
                </div>
                <p>{entry.data.location}</p>
                <dl>
                  <div>
                    <dt>{zh ? "距离" : "Distance"}</dt>
                    <dd>{formatDistance(entry.data.distance) ?? "—"}</dd>
                  </div>
                  <div>
                    <dt>{zh ? "用时" : "Time"}</dt>
                    <dd>
                      {formatDuration(entry.data.duration, locale) ?? "—"}
                    </dd>
                  </div>
                </dl>
              </a>
            </li>
          ))}
        </ol>
        <a class="text-link" href={localizePath("/map", locale)}>
          {zh ? "全部足迹" : "All journeys"}
          <ArrowIcon direction="up-right" />
        </a>
      </section>
    )
  }
  {
    films.length > 0 && (
      <section class="recent-cinema" aria-labelledby="cinema-heading">
        <header class="section-head">
          <div>
            <>
              <h2 id="cinema-heading">
                {zh ? "最近看过" : "Recently watched"}
              </h2>
              <p>
                {zh
                  ? "银幕落下以后，还记得的那些故事。"
                  : "Stories that stay with me after the credits roll."}
              </p>
            </>
          </div>
        </header>
        <div class="recent-cinema__grid">
          {films.map((item) => (
            <MediaCard item={item} locale={locale} compact />
          ))}
        </div>
        <a
          class="text-link"
          href={`${localizePath("/media", locale)}?category=movies`}
        >
          {zh ? "浏览观影记录" : "Browse the film diary"}
          <ArrowIcon direction="up-right" />
        </a>
      </section>
    )
  }
</div>
