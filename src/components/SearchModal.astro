---
import { editorial } from "../i18n/editorial";
import type { Locale } from "../i18n/utils";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = editorial(locale);
const zh = locale === "zh-CN";
const labels = {
  blog: c.writing,
  essays: c.notes,
  research: c.notebook,
  projects: c.work,
  map: c.routes,
  lab: "WEB3 LAB",
};
---

<div
  class="search-modal"
  data-search-modal
  data-locale={locale}
  data-labels={JSON.stringify(labels)}
>
  <button
    type="button"
    class="icon-button"
    data-search-open
    aria-label={zh ? "搜索文章（Ctrl 或 ⌘ K）" : "Search writing (Ctrl or ⌘ K)"}
    title={zh ? "搜索 · ⌘ K" : "Search · ⌘ K"}
    ><svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
      ><circle cx="10.8" cy="10.8" r="6.7"></circle><path d="m16 16 4.7 4.7"
      ></path></svg
    ></button
  >
  <dialog
    class="search-dialog"
    aria-label={zh ? "搜索文章" : "Search writing"}
    data-search-dialog
  >
    <div class="search-heading">
      <label class="sr-only" for="site-search-input"
        >{
          zh ? "搜索标题、摘要或标签" : "Search titles, descriptions or tags"
        }</label
      ><input
        id="site-search-input"
        data-search-input
        type="search"
        placeholder={zh
          ? "搜索文章、主题或标签…"
          : "Search writing, topics or tags…"}
        autocomplete="off"
        aria-controls="search-results"
      /><button
        class="icon-button"
        type="button"
        data-search-close
        aria-label={zh ? "关闭搜索" : "Close search"}>×</button
      >
    </div>
    <div class="search-results" id="search-results" data-search-results>
      <p class="search-message" role="status">
        {zh ? "从一个关键词开始。" : "Start with a keyword."}
      </p>
    </div>
    <div class="search-help">
      <span>↑ ↓ {zh ? "选择" : "Select"} · ↵ {zh ? "打开" : "Open"}</span><span
        >esc {zh ? "关闭" : "Close"}</span
      >
    </div>
    <template data-search-template
      ><a class="search-result"
        ><span data-result-kind></span><strong data-result-title></strong><small
          data-result-date></small></a
      ></template
    >
  </dialog>
</div>
<script>
  interface SearchEntry {
    title: string;
    description: string;
    tags: string[];
    collection: string;
    url: string;
    date: string;
  }
  const root = document.querySelector<HTMLElement>("[data-search-modal]");
  if (root) {
    const zh = root.dataset.locale === "zh-CN";
    const labels = JSON.parse(root.dataset.labels ?? "{}") as Record<
      string,
      string
    >;
    const dialog = root.querySelector<HTMLDialogElement>(
      "[data-search-dialog]",
    )!;
    const input = root.querySelector<HTMLInputElement>("[data-search-input]")!;
    const results = root.querySelector<HTMLElement>("[data-search-results]")!;
    const template = root.querySelector<HTMLTemplateElement>(
      "[data-search-template]",
    )!;
    let fuse: import("fuse.js").default<SearchEntry> | undefined;
    let loading: Promise<boolean> | undefined;
    let selected = 0;
    let previousFocus: HTMLElement | null = null;
    let previousOverflow = "";
    const message = (text: string) => {
      const p = document.createElement("p");
      p.className = "search-message";
      p.setAttribute("role", "status");
      p.textContent = text;
      results.replaceChildren(p);
    };
    const load = () =>
      (loading ??= Promise.all([
        import("fuse.js"),
        fetch(`/${root.dataset.locale}/search-index.json`).then((response) => {
          if (!response.ok) throw Error("Search unavailable");
          return response.json() as Promise<SearchEntry[]>;
        }),
      ])
        .then(([module, entries]) => {
          fuse = new module.default(entries, {
            keys: [
              { name: "title", weight: 0.6 },
              { name: "description", weight: 0.25 },
              { name: "tags", weight: 0.15 },
            ],
            threshold: 0.35,
            ignoreLocation: true,
          });
          return true;
        })
        .catch(() => {
          message(
            zh
              ? "搜索暂时无法加载，请关闭后重试。"
              : "Search couldn't load. Close and try again.",
          );
          loading = undefined;
          return false;
        }));
    const select = (index: number) => {
      const links = [...results.querySelectorAll<HTMLAnchorElement>("a")];
      selected = Math.max(0, Math.min(index, links.length - 1));
      links.forEach((link, i) => {
        link.classList.toggle("is-selected", i === selected);
        if (i === selected) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      });
      links[selected]?.scrollIntoView({ block: "nearest" });
    };
    const search = () => {
      if (!fuse) return;
      const query = input.value.trim();
      if (!query) {
        message(
          zh
            ? "输入标题、主题或标签，寻找一篇文章。"
            : "Find an article by title, topic or tag.",
        );
        return;
      }
      const matches = fuse
        .search(query)
        .slice(0, 8)
        .map((result) => result.item);
      if (!matches.length) {
        message(
          zh
            ? `没有找到“${query}”，试试其他关键词。`
            : `No results for “${query}”. Try another keyword.`,
        );
        return;
      }
      results.replaceChildren(
        ...matches.map((entry) => {
          const node = template.content.firstElementChild!.cloneNode(
            true,
          ) as HTMLAnchorElement;
          node.href = entry.url;
          node.querySelector("[data-result-kind]")!.textContent =
            labels[entry.collection] ?? entry.collection;
          node.querySelector("[data-result-title]")!.textContent = entry.title;
          node.querySelector("[data-result-date]")!.textContent = entry.date;
          return node;
        }),
      );
      select(0);
    };
    const open = async () => {
      if (dialog.open) return;
      previousFocus = document.activeElement as HTMLElement;
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
      dialog.showModal();
      input.focus();
      if (!fuse) {
        message(zh ? "正在加载文章…" : "Loading writing…");
        if (!(await load())) return;
      }
      if (dialog.open) search();
    };
    root.querySelector("[data-search-open]")?.addEventListener("click", open);
    root
      .querySelector("[data-search-close]")
      ?.addEventListener("click", () => dialog.close());
    // Search inputs can consume Escape to clear text before the dialog closes.
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        event.stopPropagation();
        dialog.close();
      }
    });
    dialog.addEventListener("close", () => {
      document.body.style.overflow = previousOverflow;
      input.value = "";
      previousFocus?.focus();
    });
    dialog.addEventListener("click", (event) => {
      const rect = dialog.getBoundingClientRect();
      if (
        event.target === dialog &&
        (event.clientX < rect.left ||
          event.clientX > rect.right ||
          event.clientY < rect.top ||
          event.clientY > rect.bottom)
      )
        dialog.close();
    });
    input.addEventListener("input", search);
    input.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        event.preventDefault();
        select(selected + (event.key === "ArrowDown" ? 1 : -1));
      }
      if (event.key === "Enter") {
        event.preventDefault();
        results.querySelectorAll<HTMLAnchorElement>("a")[selected]?.click();
      }
    });
    window.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        dialog.open ? dialog.close() : open();
      }
    });
  }
</script>
