---
import ArrowIcon from "./ArrowIcon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleRow from "./ArticleRow.astro";
import { editorial } from "../i18n/editorial";
import { localizePath, type Locale } from "../i18n/utils";
import type { WritingEntry } from "../lib/writing";
import type { PageLinks } from "../lib/pagination";
import {
  ARTICLE_FORMATS,
  writingFormatLabel,
  type WritingCategory,
} from "../lib/content-policy";
interface Props {
  entries: WritingEntry[];
  page: PageLinks;
  category?: WritingCategory | "all";
  format?: string;
  /** Collection pages such as /essays supply their own heading. */
  title?: string;
  description?: string;
}
const {
  entries,
  page,
  category = "all",
  format,
  title,
  description,
} = Astro.props;
const locale = (Astro.currentLocale ?? "zh-CN") as Locale;
const zh = locale === "zh-CN";
const c = editorial(locale);
const formatDescriptions: Record<string, string> = zh
  ? {
      guide: "部署步骤、配置记录，和可以照着做的技术实践。",
      research: "对安全机制和研究工作的梳理与分析。",
      essay: "旅行见闻、书评，还有对一段生活的回望。",
    }
  : {
      guide:
        "Deployment steps, configuration notes and technical practice you can follow.",
      research: "Close readings of security mechanisms and research work.",
      essay: "Travel, book reviews, and looking back on stretches of life.",
    };
// Earlier subject pages remain reachable at their original URLs.
const topics: Record<WritingCategory, { title: string; description: string }> =
  zh
    ? {
        technology: {
          title: "技术实践",
          description: "技术指南和动手实践的记录。",
        },
        research: {
          title: c.notebook,
          description: formatDescriptions.research,
        },
        life: {
          title: c.essays,
          description: "旅行、读书和日常生活里的文字。",
        },
      }
    : {
        technology: {
          title: c.technology,
          description: "Technical guides and hands-on practice.",
        },
        research: {
          title: c.notebook,
          description: formatDescriptions.research,
        },
        life: {
          title: c.essays,
          description: "Writing about travel, books and everyday life.",
        },
      };
const topic = category === "all" ? undefined : topics[category];
const pageTitle =
  title ??
  (format
    ? writingFormatLabel(format as (typeof ARTICLE_FORMATS)[number], locale)
    : (topic?.title ?? c.writingTitle));
const pageDescription =
  description ??
  (format ? formatDescriptions[format] : (topic?.description ?? c.writingDeck));
const filters = [
  { key: "all", label: zh ? "全部" : "All", href: "/blog" },
  ...ARTICLE_FORMATS.map((key) => ({
    key,
    label: writingFormatLabel(key, locale),
    href: `/blog/formats/${key}`,
  })),
];
const current = format ?? (category === "all" ? "all" : undefined);
// Entries arrive newest first; the year becomes the heading for its rows.
const years = entries.reduce<{ year: number; entries: WritingEntry[] }[]>(
  (groups, entry) => {
    const year = entry.data.date.getFullYear();
    const last = groups.at(-1);
    if (last?.year === year) last.entries.push(entry);
    else groups.push({ year, entries: [entry] });
    return groups;
  },
  [],
);
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="page-container archive-page">
    <header class="page-intro">
      <div class="archive-heading">
        <div>
          <h1>{pageTitle}</h1><p>{pageDescription}</p>
        </div>
        <a class="text-link" href={localizePath("/subscribe", locale)}
          >{c.subscribe}</a
        >
      </div>
    </header>
    <div class="archive-layout">
      <aside class="archive-navigation">
        <h2>{zh ? "按类型阅读" : "By type"}</h2>
        <nav class="format-tabs" aria-label={zh ? "文章类型" : "Writing type"}>
          {
            filters.map((item) => (
              <a
                aria-current={current === item.key ? "page" : undefined}
                href={localizePath(item.href, locale)}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <p class="archive-hint">
          {
            zh ? "几句话和照片的日常，在" : "Shorter everyday entries live in "
          }<a href={localizePath("/blog/formats/note", locale)}
            >{zh ? "随记" : "Notes"}</a
          >{zh ? "里按时间连续阅读。" : ", read as a timeline."}
        </p>
        <a class="archive-tags" href={localizePath("/tags", locale)}
          >{zh ? "按标签浏览" : "Browse by tag"}</a
        >
      </aside>
      <div class="archive-records">
        <p class="archive-count">{page.total} {c.results}</p>
        {
          years.length > 0 ? (
            years.map((group) => (
              <section
                class="archive-year"
                aria-labelledby={`archive-year-${group.year}`}
              >
                <h2
                  class="archive-year__title"
                  id={`archive-year-${group.year}`}
                >
                  {group.year}
                </h2>
                <div class="writing-list">
                  {group.entries.map((entry) => (
                    <ArticleRow
                      entry={entry}
                      locale={locale}
                      withinYear
                      showFormat={!format}
                      showReadingTime={false}
                    />
                  ))}
                </div>
              </section>
            ))
          ) : (
            <div class="empty-note">
              <>
                <p>{c.empty}</p>
                <a class="text-link" href={localizePath("/blog", locale)}>
                  {c.browse} <ArrowIcon direction="right" />
                </a>
              </>
            </div>
          )
        }
        {
          page.last > 1 && (
            <nav
              class="pagination"
              aria-label={zh ? "文章分页" : "Writing pages"}
            >
              {page.prev ? (
                <a href={localizePath(page.prev, locale)}>
                  <ArrowIcon direction="left" /> {zh ? "上一页" : "Previous"}
                </a>
              ) : (
                <span />
              )}
              <span>
                {page.current} / {page.last}
              </span>
              {page.next ? (
                <a href={localizePath(page.next, locale)}>
                  {zh ? "下一页" : "Next"} <ArrowIcon direction="right" />
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
