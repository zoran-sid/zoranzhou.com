---
import ArrowIcon from "./ArrowIcon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleRow from "./ArticleRow.astro";
import NoteCard from "./NoteCard.astro";
import { editorial } from "../i18n/editorial";
import { localizePath, type Locale } from "../i18n/utils";
import type { WritingEntry } from "../lib/writing";
import type { PageLinks } from "../lib/pagination";
interface Props {
  entries: WritingEntry[];
  page: PageLinks;
  category?: string;
  format?: string;
  title?: string;
  description?: string;
}
const {
  entries,
  page,
  category = "all",
  format,
  title,
  description,
} = Astro.props;
const locale = (Astro.currentLocale ?? "zh-CN") as Locale;
const c = editorial(locale);
const formatTitles: Record<string, string> =
  locale === "zh-CN"
    ? { note: "随记", guide: "指南", essay: "文章与随笔" }
    : { note: "Notes", guide: "Guides", essay: "Essays" };
const formatDescriptions: Record<string, string> =
  locale === "zh-CN"
    ? {
        note: "几句话，一张照片，记下此刻的生活和想法。",
        guide: "持续整理的技术文档、部署步骤与实践记录。",
        essay: "技术分析、阅读感想，以及生活中慢慢形成的思考。",
      }
    : {
        note: "A few words, a photograph, a moment from everyday life.",
        guide:
          "Technical documentation, deployment steps and records of practice.",
        essay:
          "Technical analysis, reflections on books and thoughts from everyday life.",
      };
const pageTitle = title ?? (format ? formatTitles[format] : c.writingTitle);
const pageDescription =
  description ?? (format ? formatDescriptions[format] : c.writingDeck);
const filters = [
  { key: "all", label: c.all },
  { key: "technology", label: c.technology },
  { key: "research", label: c.researchFilter },
  { key: "life", label: c.essays },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="page-container archive-page">
    <header class="page-intro">
      <div class="archive-heading">
        <div>
          <h1>{pageTitle.split("\n").map((line) => <span>{line}</span>)}</h1><p>
            {pageDescription}
          </p>
        </div>
        <a class="text-link" href={localizePath("/subscribe", locale)}
          >{c.subscribe}</a
        >
      </div>
    </header>
    <div class="archive-layout">
      <aside class="archive-navigation">
        <h2>{locale === "zh-CN" ? "按形式阅读" : "By format"}</h2>
        <nav
          class="format-tabs"
          aria-label={locale === "zh-CN" ? "内容形式" : "Writing format"}
        >
          {
            [
              { key: "all", zh: "全部文章", en: "All writing" },
              { key: "note", zh: "随记", en: "Notes" },
              { key: "guide", zh: "技术指南", en: "Guides" },
              { key: "essay", zh: "文章与随笔", en: "Essays" },
            ].map((item) => (
              <a
                aria-current={
                  (format ?? "all") === item.key && category === "all"
                    ? "page"
                    : undefined
                }
                href={localizePath(
                  item.key === "all" ? "/blog" : `/blog/formats/${item.key}`,
                  locale,
                )}
              >
                {locale === "zh-CN" ? item.zh : item.en}
              </a>
            ))
          }
        </nav>
        <h2>{locale === "zh-CN" ? "按主题浏览" : "By subject"}</h2>
        <nav class="topic-navigation" aria-label={c.filter}>
          {
            filters
              .filter((filter) => filter.key !== "all")
              .map((filter) => (
                <a
                  aria-current={category === filter.key ? "page" : undefined}
                  href={localizePath(`/blog/topics/${filter.key}`, locale)}
                >
                  {filter.label}
                </a>
              ))
          }
          <a href={localizePath("/tags", locale)}
            >{locale === "zh-CN" ? "全部标签" : "All tags"}</a
          >
        </nav>
        <p class="archive-hint">
          {
            locale === "zh-CN"
              ? "记录可以很短，问题也可以慢慢展开。"
              : "Some entries begin as a small observation. Others take more room."
          }
        </p>
      </aside>
      <div class="archive-records">
        <p class="archive-count">{page.total} {c.results}</p>
        {
          entries.length > 0 ? (
            <div class:list={[format === "note" ? "notes-feed" : "writing-list"]}>
              {entries.map((entry) => format === "note" ? (
                <NoteCard entry={entry} locale={locale} />
              ) : (
                <ArticleRow entry={entry} locale={locale} />
              ))}
            </div>
          ) : (
            <div class="empty-note">
              <>
                <p>{format === "note" ? (locale === "zh-CN" ? "还没有公开的随记。写下第一条后，就会按时间出现在这里。" : "No notes published yet. New notes will appear here, newest first.") : c.empty}</p>
                <a class="text-link" href={localizePath("/blog", locale)}>
                  {c.browse} <ArrowIcon direction="up-right" />
                </a>
              </>
            </div>
          )
        }
        {
          page.last > 1 && (
            <nav
              class="pagination"
              aria-label={locale === "zh-CN" ? "文章分页" : "Writing pages"}
            >
              {page.prev ? (
                <a href={localizePath(page.prev, locale)}>
                  <ArrowIcon direction="left" />{" "}
                  {locale === "zh-CN" ? "上一页" : "Previous"}
                </a>
              ) : (
                <span />
              )}
              <span>
                {page.current} / {page.last}
              </span>
              {page.next ? (
                <a href={localizePath(page.next, locale)}>
                  {locale === "zh-CN" ? "下一页" : "Next"}{" "}
                  <ArrowIcon direction="right" />
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
