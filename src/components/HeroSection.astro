---
import ExplorationMap from "./ExplorationMap.astro";
import { editorial } from "../i18n/editorial";
import { localizePath, type Locale } from "../i18n/utils";
import type { WritingEntry } from "../lib/writing";
interface Props {
  entries: WritingEntry[];
}
const { entries } = Astro.props;
const locale = (Astro.currentLocale ?? "zh-CN") as Locale;
const c = editorial(locale);
---

<section class="editorial-hero page-container">
  <div class="editorial-hero__copy">
    <p class="eyebrow">
      <span class="identity-dot" aria-hidden="true"></span>{c.identity}
    </p>
    <h1>{c.headline[0]}<br /><span>{c.headline[1]}</span></h1>
    <p class="editorial-hero__intro">{c.intro}</p>
    <div class="hero-actions">
      <a class="button-primary" href="#selected"
        >{c.start}<span aria-hidden="true">↓</span></a
      ><a class="text-link" href={localizePath("/about", locale)}
        >{c.about}<span aria-hidden="true">↗</span></a
      >
    </div>
  </div>
  <ExplorationMap entries={entries} locale={locale} />
</section>
