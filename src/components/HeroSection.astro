---
import ArrowIcon from "./ArrowIcon.astro";
import { localizePath, type Locale } from "../i18n/utils";
import { getCollection } from "astro:content";
import { getLabEntryPath, LAB_CURRENT_FOCUS_KEY } from "../lib/lab";
import { isPublished } from "../lib/content-policy";
import { now } from "../data/now";
const locale = (Astro.currentLocale ?? "zh-CN") as Locale;
const zh = locale === "zh-CN";
const labFocus = (await getCollection("lab")).find(
  (entry) =>
    isPublished(entry) &&
    entry.data.lang === locale &&
    entry.data.translationKey === LAB_CURRENT_FOCUS_KEY,
);
---

<section class="garden-hero page-container">
  <div class="hero-name-stage">
    <h1 data-motion="cover" data-hero-title aria-label="Zoran Zhou">
      {
        "Zoran Zhou".split("").map((character) => (
          <span class="hero-name-letter" aria-hidden="true">
            {character === " " ? "\u00a0" : character}
          </span>
        ))
      }
    </h1>
  </div>
  <div class="garden-introduction" data-motion="cover" data-motion-delay="100">
    <p class="garden-deck">
      {
        zh
          ? "你好，我是 Zoran。这里记录我在网络安全、软件开发、数据与 AI 方面的学习和实践，也收集摄影、旅途和生活里的想法。"
          : "I’m Zoran. I write about learning and working with security, software, data and AI, alongside photographs, journeys and everyday life."
      }
    </p>
    <div class="hero-actions">
      <a class="button-primary" href={localizePath("/blog", locale)}
        >{zh ? "阅读文章" : "Read the writing"}</a
      >
      <a class="text-link" href={localizePath("/about", locale)}
        >{zh ? "更多关于我" : "More about me"}</a
      >
    </div>
  </div>
  <div class="garden-index">
    <aside class="garden-now" aria-labelledby="now-heading">
      <h2 id="now-heading">{zh ? "近况" : "At the moment"}</h2>
      <p>{now[locale].body}</p>
      <a
        class="text-link"
        href={labFocus
          ? getLabEntryPath(labFocus)
          : localizePath("/lab", locale)}
        >{now[locale].linkLabel}<span aria-hidden="true"
          ><ArrowIcon direction="up-right" /></span
        ></a
      >
    </aside>
    <nav
      class="garden-paths"
      aria-label={zh ? "从兴趣出发" : "Explore by interest"}
    >
      <a href={localizePath("/blog/formats/guide", locale)}
        ><span>{zh ? "技术与实践" : "Technical practice"}</span><span
          >{
            zh
              ? "指南、研究与问题的解法"
              : "Guides, research and working things out"
          }</span
        ></a
      >
      <a href={localizePath("/life", locale)}
        ><span>{zh ? "生活记录" : "Life beyond work"}</span><span
          >{
            zh
              ? "摄影、行走与日常所想"
              : "Photography, journeys and everyday thoughts"
          }</span
        ></a
      >
    </nav>
  </div>
</section>
<script>
  const stage = document.querySelector<HTMLElement>(".hero-name-stage");
  const letters = [
    ...(stage?.querySelectorAll<HTMLElement>(".hero-name-letter") ?? []),
  ];
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  let frame = 0;
  let pointer: { x: number; y: number } | null = null;
  let centers: { x: number; y: number }[] = [];

  function resetLetters() {
    cancelAnimationFrame(frame);
    frame = 0;
    pointer = null;
    letters.forEach((letter) => letter.style.removeProperty("transform"));
  }
  function measureLetters() {
    if (!stage) return;
    const bounds = stage.getBoundingClientRect();
    centers = letters.map((letter) => {
      const rect = letter.getBoundingClientRect();
      return {
        x: rect.left + rect.width / 2 - bounds.left,
        y: rect.top + rect.height / 2 - bounds.top,
      };
    });
  }
  function paintLetters() {
    frame = 0;
    if (!stage || !pointer || reduced.matches) return;
    // One layout read per frame; letter transforms never feed back into their origins.
    const bounds = stage.getBoundingClientRect();
    const x = pointer.x - bounds.left,
      y = pointer.y - bounds.top;
    letters.forEach((letter, index) => {
      const center = centers[index];
      if (!center) return;
      const influence = Math.max(
        0,
        1 - Math.hypot(x - center.x, y - center.y) / 180,
      );
      letter.style.transform = `translateY(${(-8 * influence).toFixed(2)}px) scaleX(${(1 + influence * 0.2).toFixed(3)}) skewX(${((x - center.x) * 0.025 * influence).toFixed(2)}deg)`;
    });
  }
  stage?.addEventListener("pointerenter", measureLetters);
  stage?.addEventListener("pointermove", (event) => {
    if (reduced.matches || event.pointerType === "touch") return;
    pointer = { x: event.clientX, y: event.clientY };
    if (!frame) frame = requestAnimationFrame(paintLetters);
  });
  stage?.addEventListener("pointerleave", resetLetters);
  reduced.addEventListener("change", resetLetters);
  const resize = () => {
    resetLetters();
    measureLetters();
  };
  window.addEventListener("resize", resize, { passive: true });
  const hidden = () => {
    if (document.hidden) resetLetters();
  };
  document.addEventListener("visibilitychange", hidden);
  document.addEventListener(
    "astro:before-swap",
    () => {
      resetLetters();
      window.removeEventListener("resize", resize);
      document.removeEventListener("visibilitychange", hidden);
      reduced.removeEventListener("change", resetLetters);
    },
    { once: true },
  );
</script>
