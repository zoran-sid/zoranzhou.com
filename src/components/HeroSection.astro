---
import NoteCard from "./NoteCard.astro";
import { localizePath, type Locale } from "../i18n/utils";
import type { WritingEntry } from "../lib/writing";
interface Props { latestNote?: WritingEntry }
const { latestNote } = Astro.props;
const locale = (Astro.currentLocale ?? "zh-CN") as Locale;
const zh = locale === "zh-CN";
---

<section class="garden-hero page-container">
  <div class="hero-name-stage">
    <h1 data-hero-title aria-label="Zoran">
      {
        "Zoran".split("").map((character, index) => (
          <span
            class:list={["hero-name-letter", `hero-letter-${index}`]}
            aria-hidden="true"
          >
            {character === " " ? "\u00a0" : character}
          </span>
        ))
      }
      <span class="hero-baseline" aria-hidden="true"></span>
    </h1>
    <span class="hero-ball" aria-hidden="true"></span>
  </div>
  <div class="garden-introduction" data-motion="cover" data-motion-delay="100">
    <p class="garden-deck">
      {
        zh
          ? "网络工程师、安全从业者、摄影师和户外运动爱好者。"
          : "Network engineer, security practitioner, photographer, and outdoor enthusiast."
      }
    </p>
    <div class="hero-actions">
      <a class="button-primary" href={localizePath("/blog", locale)}
        >{zh ? "阅读文章" : "Read the writing"}</a
      >
      <a class="text-link" href={localizePath("/about", locale)}
        >{zh ? "更多关于我" : "More about me"}</a
      >
    </div>
  </div>
  <div class="garden-index">
    <aside class="garden-notes" aria-labelledby="notes-heading">
      <div class="garden-notes__heading">
        <h2 id="notes-heading">{zh ? "随记" : "Notes"}</h2>
        <a class="text-link" href={localizePath("/blog/formats/note", locale)}>{zh ? "所有随记" : "All notes"}</a>
      </div>
      <div class="garden-notes__latest">
        {latestNote ? <NoteCard entry={latestNote} locale={locale} compact /> : <p class="garden-notes__empty">{zh ? "随手记下的想法、照片，还有日常里值得留住的片刻。第一条随记还在酝酿。" : "Thoughts, photographs and small moments from everyday life. The first note is still to come."}</p>}
      </div>
    </aside>
  </div>
</section>
<script>
  import { nameBounceFrames } from "../lib/name-bounce";
  const stage = document.querySelector<HTMLElement>(".hero-name-stage");
  const ball = stage?.querySelector<HTMLElement>(".hero-ball");
  const letters = [
    ...(stage?.querySelectorAll<HTMLElement>(".hero-name-letter") ?? []),
  ];
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const animations: Animation[] = [];
  const settle = () => {
    animations.forEach((animation) => animation.cancel());
    animations.length = 0;
  };
  async function introduceName() {
    await document.fonts.ready;
    if (!stage || !ball || reduced.matches || document.hidden) return;
    const context = document.createElement("canvas").getContext("2d");
    const baseline = stage.querySelector<HTMLElement>(".hero-baseline");
    if (!context || !baseline) return;
    const bounds = stage.getBoundingClientRect();
    const baselineY = baseline.getBoundingClientRect().top - bounds.top;
    const diameter = ball.offsetWidth;
    const visibleLetters = letters.filter((letter) =>
      letter.textContent?.trim(),
    );
    // Actual glyph ascenders put o and u below Z; the empty span marks the baseline.
    const impacts = visibleLetters.map((letter) => {
      const box = letter.getBoundingClientRect();
      const style = getComputedStyle(letter);
      context.font = `${style.fontStyle} ${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
      const ascent = context.measureText(
        letter.textContent!.trim(),
      ).actualBoundingBoxAscent;
      return {
        x: box.left - bounds.left + box.width / 2 - diameter / 2,
        y: baselineY - ascent - diameter + 2,
      };
    });
    const sequence = nameBounceFrames(impacts, diameter);
    animations.push(
      ball.animate(sequence.frames, {
        duration: sequence.duration,
        easing: "linear",
      }),
    );
    visibleLetters.forEach((letter, index) => {
      animations.push(
        letter.animate(
          [
            { transform: "none", offset: 0 },
            { transform: "translateY(.025em) scaleY(.96)", offset: 0.2 },
            {
              transform: `translateY(-.08em) rotate(${index % 2 ? 3 : -3}deg)`,
              offset: 0.5,
            },
            { transform: "none", offset: 1 },
          ],
          {
            duration: 360,
            delay: (index + 1) * sequence.hop,
            easing: "ease-out",
          },
        ),
      );
    });
  }
  void introduceName();
  reduced.addEventListener("change", settle);
  window.addEventListener("resize", settle, { passive: true });
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) settle();
  });
  document.addEventListener("astro:before-swap", settle, { once: true });
</script>
