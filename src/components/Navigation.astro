---
import GardenMark from "./GardenMark.astro";
import "../styles/navigation.css";
import SearchModal from "./SearchModal.astro";
import { localizePath, LANG_COOKIE, type Locale } from "../i18n/utils";
interface Props {
  alternateHref: string;
}
const { alternateHref } = Astro.props;
const locale = (Astro.currentLocale ?? "zh-CN") as Locale;
const alternateLocale: Locale = locale === "zh-CN" ? "en" : "zh-CN";
const section = Astro.url.pathname.split("/").filter(Boolean)[1] ?? "";
const zh = locale === "zh-CN";
const gardenItems = [
  {
    label: zh ? "文章" : "Blog",
    href: "/blog",
    description: zh
      ? "技术实践、长文与随记"
      : "Technical writing, essays and short notes",
  },
  {
    label: zh ? "随笔" : "Essays",
    href: "/blog/formats/essay",
    description: zh
      ? "生活随笔、观察与长一点的思考"
      : "Personal reflections, observations and longer thoughts",
  },
  {
    label: zh ? "书架" : "Library",
    href: "/library",
    description: zh
      ? "读过的书与还想翻开的世界"
      : "Books read and worlds still to explore",
  },
  {
    label: zh ? "摄影" : "Photography",
    href: "/photos",
    description: zh
      ? "旅途和日常里的光影"
      : "Light and moments from everyday life and travels",
  },
];
const items = [
  ...gardenItems,
  { label: zh ? "近况" : "Now", href: "/now" },
  { label: zh ? "关于我" : "About", href: "/about" },
];
---

<header class="site-header" data-site-header data-language-cookie={LANG_COOKIE}>
  <nav
    class="site-nav page-container"
    aria-label={locale === "zh-CN" ? "主导航" : "Main navigation"}
  >
    <a
      href={localizePath("/", locale)}
      class="site-brand"
      aria-label={locale === "zh-CN" ? "Zoran Zhou 首页" : "Zoran Zhou home"}
      ><GardenMark /></a
    >
    <div class="site-nav__links">
      <div class="garden-navigation">
        <a class="site-nav__link" href={localizePath("/blog", locale)}
          >{zh ? "花园" : "The Garden"}</a
        >
        <details class="garden-disclosure">
          <summary aria-label={zh ? "展开网站目录" : "Explore the garden"}>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"><path d="m5 9 7 7 7-7"></path></svg
            >
          </summary>
          <div class="garden-dropdown">
            {
              gardenItems.map((item) => (
                <a href={localizePath(item.href, locale)}>
                  <span>
                    <>
                      <strong>{item.label}</strong>
                      <small>{item.description}</small>
                    </>
                  </span>
                </a>
              ))
            }
          </div>
        </details>
      </div>
      <a
        class="site-nav__link"
        href={localizePath("/now", locale)}
        aria-current={section === "now" ? "page" : undefined}
        >{zh ? "近况" : "Now"}</a
      >
      <a
        class="site-nav__link"
        href={localizePath("/about", locale)}
        aria-current={section === "about" ? "page" : undefined}
        >{zh ? "关于我" : "About"}</a
      >
    </div>
    <div class="site-nav__tools">
      <SearchModal locale={locale} /><a
        class="site-nav__language"
        href={alternateHref}
        data-language-switch
        data-target-locale={alternateLocale}
        aria-label={locale === "zh-CN" ? "Switch to English" : "切换为中文"}
        >{locale === "zh-CN" ? "EN" : "中文"}</a
      ><button
        type="button"
        id="theme-toggle"
        class="icon-button"
        aria-label={locale === "zh-CN" ? "深色模式" : "Dark mode"}
        aria-pressed="false"
        ><svg
          class="theme-sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"
          ></path></svg
        ><svg
          class="theme-moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          ><path d="M20.5 14.5A9 9 0 0 1 9.5 3.5a9 9 0 1 0 11 11Z"></path></svg
        ></button
      ><button
        type="button"
        id="mobile-menu-toggle"
        class="icon-button site-nav__menu"
        aria-label={locale === "zh-CN" ? "打开或关闭导航" : "Toggle navigation"}
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-haspopup="dialog"
        data-open-label={zh ? "打开导航" : "Open navigation"}
        data-close-label={zh ? "关闭导航" : "Close navigation"}
        ><svg
          class="menu-icon menu-icon--open"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"><path d="M4 8h16M4 16h16"></path></svg
        ><svg
          class="menu-icon menu-icon--close"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          aria-hidden="true"><path d="m5 5 14 14M19 5 5 19"></path></svg
        ></button
      >
    </div>
  </nav>
  <dialog
    id="mobile-menu"
    class="garden-mobile"
    aria-label={zh ? "网站导航" : "Site navigation"}
  >
    <div class="garden-mobile__body">
      <nav
        class="garden-mobile__links"
        aria-label={zh ? "全部栏目" : "All sections"}
      >
        {
          items.map((item) => (
            <a href={localizePath(item.href, locale)}>{item.label}</a>
          ))
        }
      </nav>
    </div>
  </dialog>
  <noscript
    ><nav
      class="page-container fallback-nav"
      aria-label={zh ? "网站目录" : "Site directory"}
    >
      {
        items.map((item) => (
          <a href={localizePath(item.href, locale)}>{item.label}</a>
        ))
      }
    </nav></noscript
  >
</header>
<script>
  import { initTheme, toggleTheme } from "../lib/theme";
  initTheme();
  document
    .getElementById("theme-toggle")
    ?.addEventListener("click", toggleTheme);
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.querySelector<HTMLDialogElement>("#mobile-menu");
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const nav = header?.querySelector<HTMLElement>(".site-nav");
  const drawer = menu?.querySelector<HTMLElement>(".garden-mobile__body");
  const disclosure =
    document.querySelector<HTMLDetailsElement>(".garden-disclosure");
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  const desktop = matchMedia("(min-width: 1024px)");
  let previousBodyOverflow = "";
  let previousRootOverflow = "";
  let previousHeaderHeight = "";
  let drawerAnimation: Animation | undefined;
  let closing = false;
  let active = false;

  function restoreToolbar() {
    if (!active) return;
    active = false;
    drawerAnimation?.cancel();
    drawerAnimation = undefined;
    closing = false;
    if (header && nav && menu) {
      header.insertBefore(nav, menu);
      header.style.minHeight = previousHeaderHeight;
    }
    document.body.style.overflow = previousBodyOverflow;
    document.documentElement.style.overflow = previousRootOverflow;
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", toggle.dataset.openLabel!);
    if (!desktop.matches) toggle?.focus({ preventScroll: true });
  }

  function finishClose() {
    menu?.close();
    // Restore synchronously, including pagehide before the browser freezes the page.
    restoreToolbar();
  }

  function closeMenu(immediate = false) {
    if (!menu?.open) return;
    if (closing && !immediate) return;
    closing = true;
    drawerAnimation?.cancel();
    drawerAnimation = undefined;
    if (immediate || reducedMotion.matches || !drawer) {
      finishClose();
      return;
    }
    const animation = drawer.animate(
      [{ transform: "translateX(0)" }, { transform: "translateX(100%)" }],
      { duration: 240, easing: "cubic-bezier(.4, 0, 1, 1)", fill: "forwards" },
    );
    drawerAnimation = animation;
    void animation.finished
      .then(() => {
        if (drawerAnimation === animation) finishClose();
      })
      .catch(() => {}); // A resize or reduced-motion change can cancel the exit.
  }
  toggle?.addEventListener("click", () => {
    if (!menu || !header || !nav || !drawer) return;
    if (menu.open) {
      closeMenu();
      return;
    }
    closing = false;
    previousBodyOverflow = document.body.style.overflow;
    previousRootOverflow = document.documentElement.style.overflow;
    previousHeaderHeight = header.style.minHeight;
    active = true;
    // Move the existing toolbar into the modal: same position, controls and listeners.
    // Its reserved space keeps the underlying page still; only the directory slides.
    header.style.minHeight = `${header.getBoundingClientRect().height}px`;
    menu.prepend(nav);
    menu.showModal();
    document.body.style.overflow = "hidden";
    document.documentElement.style.overflow = "hidden";
    toggle.setAttribute("aria-expanded", "true");
    toggle.setAttribute("aria-label", toggle.dataset.closeLabel!);
    toggle.focus({ preventScroll: true });
    if (!reducedMotion.matches) {
      drawerAnimation = drawer.animate(
        [{ transform: "translateX(100%)" }, { transform: "translateX(0)" }],
        { duration: 320, easing: "cubic-bezier(.22, 1, .36, 1)" },
      );
      void drawerAnimation.finished.catch(() => {});
    }
  });
  menu?.addEventListener("close", () => {
    if (!menu.open) restoreToolbar();
  });
  menu?.addEventListener("cancel", (event) => {
    event.preventDefault();
    closeMenu();
  });
  menu
    ?.querySelectorAll("a")
    .forEach((link) => link.addEventListener("click", () => closeMenu(true)));
  desktop.addEventListener("change", (event) => {
    if (event.matches) {
      closeMenu(true);
    }
    else if (disclosure) disclosure.open = false;
  });
  reducedMotion.addEventListener("change", () => {
    if (!reducedMotion.matches) return;
    drawerAnimation?.cancel();
    drawerAnimation = undefined;
    if (closing) closeMenu(true);
  });
  window.addEventListener("pagehide", () => closeMenu(true));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && disclosure?.open) {
      disclosure.open = false;
      disclosure.querySelector("summary")?.focus();
    }
  });
  document.addEventListener("click", (event) => {
    if (
      disclosure &&
      event.target instanceof Node &&
      !disclosure.contains(event.target)
    )
      disclosure.open = false;
  });
  document.addEventListener("focusin", (event) => {
    if (
      disclosure?.open &&
      event.target instanceof Node &&
      !disclosure.contains(event.target)
    )
      disclosure.open = false;
  });
  document
    .querySelectorAll<HTMLAnchorElement>("[data-language-switch]")
    .forEach((link) =>
      link.addEventListener("click", () => {
        const language = link.dataset.targetLocale;
        if (language !== "zh-CN" && language !== "en") return;
        const key =
          document.querySelector<HTMLElement>("[data-language-cookie]")?.dataset
            .languageCookie ?? "pref-lang";
        document.cookie = `${encodeURIComponent(key)}=${language}; Path=/; Max-Age=31536000; SameSite=Lax${location.protocol === "https:" ? "; Secure" : ""}`;
      }),
    );
</script>
