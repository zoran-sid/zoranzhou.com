---
import SearchModal from "./SearchModal.astro";
import BrandPortrait from "./BrandPortrait.astro";
import { editorial } from "../i18n/editorial";
import { localizePath, LANG_COOKIE, type Locale } from "../i18n/utils";
interface Props {
  alternateHref: string;
}
const { alternateHref } = Astro.props;
const locale = (Astro.currentLocale ?? "zh-CN") as Locale;
const c = editorial(locale);
const alternateLocale: Locale = locale === "zh-CN" ? "en" : "zh-CN";
const section = Astro.url.pathname.split("/").filter(Boolean)[1] ?? "";
const items = [
  {
    label: c.writing,
    href: "/blog",
    active: ["blog", "essays", "research", "tags"].includes(section),
  },
  { label: c.work, href: "/projects", active: section === "projects" },
  {
    label: c.life,
    href: "/life",
    active: ["life", "photos", "map", "media"].includes(section),
  },
  { label: c.about, href: "/about", active: section === "about" },
  { label: "WEB3 LAB", href: "/lab", active: false },
];
---

<header class="site-header" data-site-header data-language-cookie={LANG_COOKIE}>
  <nav
    class="site-nav page-container"
    aria-label={locale === "zh-CN" ? "主导航" : "Main navigation"}
  >
    <a
      href={localizePath("/", locale)}
      class="site-brand"
      aria-label={locale === "zh-CN" ? "Zoran Zhou 首页" : "Zoran Zhou home"}
      ><span class="site-brand__mark"><BrandPortrait /></span><span
        ><strong>ZORAN ZHOU<span class="brand-period">.</span></strong><small
          >{
            locale === "zh-CN"
              ? "构建 · 观察 · 记录"
              : "BUILD · OBSERVE · WRITE"
          }</small
        ></span
      ></a
    >
    <div class="site-nav__links">
      {
        items.map((item) => (
          <a
            href={localizePath(item.href, locale)}
            class:list={[
              "site-nav__link",
              { active: item.active, "site-nav__lab": item.href === "/lab" },
            ]}
            aria-current={item.active ? "page" : undefined}
          >
            {item.label}
            {item.href === "/lab" && <span aria-hidden="true">↗</span>}
          </a>
        ))
      }
    </div>
    <div class="site-nav__tools">
      <SearchModal locale={locale} /><a
        class="site-nav__language"
        href={alternateHref}
        data-language-switch
        data-target-locale={alternateLocale}
        aria-label={locale === "zh-CN" ? "Switch to English" : "切换为中文"}
        >{locale === "zh-CN" ? "EN" : "中文"}</a
      ><button
        type="button"
        id="theme-toggle"
        class="icon-button"
        aria-label={locale === "zh-CN" ? "切换深浅主题" : "Toggle color theme"}
        ><svg
          class="theme-sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"
          ></path></svg
        ><svg
          class="theme-moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
          ><path d="M20.5 14.5A9 9 0 0 1 9.5 3.5a9 9 0 1 0 11 11Z"></path></svg
        ></button
      ><button
        type="button"
        id="mobile-menu-toggle"
        class="icon-button site-nav__menu"
        aria-label={locale === "zh-CN" ? "打开或关闭导航" : "Toggle navigation"}
        aria-expanded="false"
        aria-controls="mobile-menu"
        ><svg
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"><path d="M4 8h16M4 16h16"></path></svg
        ></button
      >
    </div>
  </nav>
  <div id="mobile-menu" class="site-mobile-menu" hidden>
    <div class="page-container">
      {
        items.map((item, index) => (
          <a
            href={localizePath(item.href, locale)}
            aria-current={item.active ? "page" : undefined}
          >
            <span class="menu-number">0{index + 1}</span>
            {item.label}
            <span aria-hidden="true">↗</span>
          </a>
        ))
      }<div class="mobile-secondary">
        <a href={localizePath("/photos", locale)}>{c.photos}</a><a
          href={localizePath("/map", locale)}>{c.routes}</a
        ><a href={localizePath("/media", locale)}>{c.media}</a><a
          href={alternateHref}
          data-language-switch
          data-target-locale={alternateLocale}
          >{locale === "zh-CN" ? "English" : "中文"}</a
        >
      </div>
    </div>
  </div>
</header>
<script>
  import { toggleTheme } from "../lib/theme";
  document
    .getElementById("theme-toggle")
    ?.addEventListener("click", toggleTheme);
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  function setMenu(open: boolean) {
    if (menu) menu.hidden = !open;
    toggle?.setAttribute("aria-expanded", String(open));
  }
  toggle?.addEventListener("click", () => setMenu(menu?.hidden ?? true));
  menu
    ?.querySelectorAll("a")
    .forEach((link) => link.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu && !menu.hidden) {
      setMenu(false);
      toggle?.focus();
    }
  });
  window
    .matchMedia("(min-width: 1024px)")
    .addEventListener("change", (event) => {
      if (event.matches) setMenu(false);
    });
  document.addEventListener("click", (event) => {
    if (
      event.target instanceof Node &&
      !document.querySelector(".site-header")?.contains(event.target)
    )
      setMenu(false);
  });
  document
    .querySelectorAll<HTMLAnchorElement>("[data-language-switch]")
    .forEach((link) =>
      link.addEventListener("click", () => {
        const language = link.dataset.targetLocale;
        if (language !== "zh-CN" && language !== "en") return;
        const key =
          document.querySelector<HTMLElement>("[data-language-cookie]")?.dataset
            .languageCookie ?? "pref-lang";
        document.cookie = `${encodeURIComponent(key)}=${language}; Path=/; Max-Age=31536000; SameSite=Lax${location.protocol === "https:" ? "; Secure" : ""}`;
      }),
    );
</script>
