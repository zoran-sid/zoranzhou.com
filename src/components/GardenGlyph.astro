---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={["garden-glyph", className]}
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="1.15"
  aria-hidden="true"
>
  <g class="garden-glyph__circle"
    ><circle cx="20" cy="20" r="17"></circle><path
      d="M20 3C20 12 12 20 3 20C12 20 20 28 20 37C20 28 28 20 37 20C28 20 20 12 20 3Z"
    ></path></g
  >
  <g class="garden-glyph__petals"
    ><path
      d="M20 20C9 20 3 11 3 3C11 3 20 9 20 20ZM20 20C20 9 29 3 37 3C37 11 31 20 20 20ZM20 20C31 20 37 29 37 37C29 37 20 31 20 20ZM20 20C20 31 11 37 3 37C3 29 9 20 20 20Z"
    ></path></g
  >
</svg>
<style>
  .garden-glyph__circle,
  .garden-glyph__petals {
    transform-origin: center;
    transition:
      opacity 280ms ease,
      transform 350ms ease;
  }
  .garden-glyph__petals {
    opacity: 0;
    transform: scale(0.82);
  }
  :global(a:is(:hover, :focus-visible)) .garden-glyph__circle {
    opacity: 0;
    transform: scale(0.85);
  }
  :global(a:is(:hover, :focus-visible)) .garden-glyph__petals {
    opacity: 1;
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .garden-glyph__circle,
    .garden-glyph__petals {
      transition: none;
      transform: none;
    }
    :global(a:is(:hover, :focus-visible)) .garden-glyph__circle {
      transform: none;
    }
  }
</style>
