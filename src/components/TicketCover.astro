---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n/utils";
import { displayTicketDate, ticketTypeLabels } from "../lib/ticket-model";
import { ticketFields, ticketJourney, ticketValue } from "../lib/ticket-fields";
import TicketArt from "./TicketArt.astro";
import TicketIcon from "./TicketIcon.astro";
import "../styles/ticket-covers.css";
interface Props {
  ticket: CollectionEntry<"tickets">;
  locale: Locale;
  heading?: "h2" | "h3";
}
const { ticket, locale, heading: Heading = "h2" } = Astro.props;
const { title, date, type, details, location, lang } = ticket.data;
const zh = locale === "zh-CN";
const day = date.toISOString().slice(0, 10);
const journey = ticketJourney(type, details);
const transport = ["train", "flight", "travel"].includes(type);
// Codes and numbers stay on the detail page only.
const fields = ticketFields(type, details, locale).filter(
  (field) =>
    ![
      "collectionCode",
      "verificationCode",
      "taxId",
      "invoiceNumber",
      "invoiceCode",
      "receiptNumber",
      "ticketNumber",
    ].includes(field.key),
);
const typeLabel = ticketTypeLabels[locale][type];
const label = (key: string) => fields.find((field) => field.key === key);

// Film: a quiet wallet pass. Cinema in the header, then screen, seat and showtime;
// the date sits inside the showtime column rather than as a headline.
const cinema = label("cinema");
const showtime = label("startTime");
const passFacts = [label("auditorium"), label("seat")].filter(
  (field) => field !== undefined,
);
const [, month, dayOfMonth] = day.split("-").map(Number);
const shortDate = zh
  ? `${month}月${dayOfMonth}日`
  : date.toLocaleDateString("en-GB", {
      day: "numeric",
      month: "short",
      timeZone: "UTC",
    });

// Every other category: a colour plate and a perforated date stub.
const seat = label("seat");
const primary = fields.find((field) => field.key !== "seat");
const coverFields = [
  primary,
  seat ?? fields.find((field) => field.key !== primary?.key),
].filter(Boolean);
const number = ticketValue(details, "ticketNumber");
const uid = ticket.id.replace(/[^a-z0-9]/gi, "");
---

{
  type === "movie" ? (
    <div class="ticket-cover ticket-pass" data-type={type}>
      <div class="ticket-pass__card">
        <header class="ticket-pass__issuer">
          <span class="ticket-pass__badge">
            <TicketIcon type={type} />
          </span>
          <span
            class="ticket-pass__issuer-name"
            lang={cinema ? lang : undefined}
          >
            {cinema?.value ?? typeLabel}
          </span>
          <span class="ticket-pass__type">
            {cinema ? `${typeLabel} · ` : ""}
            {day.slice(0, 4)}
          </span>
        </header>
        <div>
          <p class="ticket-pass__label">{zh ? "影片" : "Film"}</p>
          <Heading lang={lang}>{title}</Heading>
        </div>
        <dl class="ticket-pass__facts">
          {passFacts.map((field) => (
            <div>
              <dt>{field!.label}</dt>
              <dd lang={lang}>{field!.value}</dd>
            </div>
          ))}
          <div>
            <dt>
              {showtime
                ? zh
                  ? "观影时间"
                  : "Showtime"
                : zh
                  ? "观影日期"
                  : "Date"}
            </dt>
            <dd>
              <time datetime={day} aria-label={displayTicketDate(date, locale)}>
                {shortDate}
              </time>
              {showtime && <span>{showtime.value}</span>}
            </dd>
          </div>
        </dl>
        {location && (
          <p class="ticket-pass__location" lang={lang}>
            {location}
          </p>
        )}
        <footer class="ticket-pass__foot">
          {lang !== locale && (
            <span class="ticket-pass__lang">
              {lang === "zh-CN" ? "中文" : "English"}
            </span>
          )}
          <span class="ticket-pass__open">
            {zh ? "查看票根" : "View ticket"}
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
            >
              <path d="M4 12h15m-6-6 6 6-6 6" />
            </svg>
          </span>
        </footer>
      </div>
    </div>
  ) : (
    <div class="ticket-cover" data-type={type}>
      <div class="ticket-cover__paper">
        <p class="ticket-cover__category">
          <span>{typeLabel}</span>
          {number && <span class="ticket-cover__number">No. {number}</span>}
          <TicketIcon type={type} />
        </p>
        <div class="ticket-cover__art">
          <TicketArt type={type} uid={uid} />
        </div>
        <Heading lang={lang}>{title}</Heading>
        <div class="ticket-cover__information">
          {transport && journey ? (
            <div class="ticket-cover__route" lang={lang}>
              <span>
                {journey.fromCode || journey.from || (zh ? "出发" : "From")}
              </span>
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="M3 12h17m-6-6 6 6-6 6" />
              </svg>
              <span>
                {journey.toCode || journey.to || (zh ? "抵达" : "To")}
              </span>
            </div>
          ) : (
            coverFields.length > 0 && (
              <dl class="ticket-cover__fields">
                {coverFields.map(
                  (field) =>
                    field && (
                      <div>
                        <dt>{field.label}</dt>
                        <dd lang={lang}>{field.value}</dd>
                      </div>
                    ),
                )}
              </dl>
            )
          )}
          {location && (
            <p class="ticket-cover__location" lang={lang}>
              {location}
            </p>
          )}
        </div>
        <footer class="ticket-cover__stub">
          <time datetime={day} aria-label={displayTicketDate(date, locale)}>
            <strong>{day.slice(5).replace("-", ".")}</strong>
            <span>{day.slice(0, 4)}</span>
          </time>
          <div class="ticket-cover__stub-end">
            {lang !== locale && (
              <span>{lang === "zh-CN" ? "中文" : "English"}</span>
            )}
            <span class="ticket-cover__open">
              {zh ? "查看票根" : "View ticket"}
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
              >
                <path d="M4 12h15m-6-6 6 6-6 6" />
              </svg>
            </span>
          </div>
        </footer>
      </div>
    </div>
  )
}
