---
interface Props {
  categories: { key: string; label: string; count?: number }[];
  activeCategory: string;
  label: string;
}

const { categories, activeCategory, label } = Astro.props;
---

<div id="media-grid-root" data-active={activeCategory}>
  <div
    class="flex flex-wrap items-center gap-2"
    role="group"
    aria-label={label}
  >
    {
      categories.map((cat) => (
        <button
          type="button"
          aria-pressed={cat.key === activeCategory ? "true" : "false"}
          data-cat={cat.key}
          aria-controls="media-results"
          class="cat-tab"
        >
          <span>{cat.label}</span>
          {typeof cat.count === "number" && (
            <span class="category-count">{cat.count}</span>
          )}
        </button>
      ))
    }
  </div>
</div>

<style>
  .cat-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.6rem 1rem;
    border: 0;
    color: var(--muted);
    background: var(--surface-soft);
    font-size: 0.875rem;
  }
  .cat-tab[aria-pressed="true"] {
    background: var(--ink);
    color: var(--page);
  }
  .cat-tab:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .category-count {
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
</style>
