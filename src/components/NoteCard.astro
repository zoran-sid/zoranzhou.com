---
import type { Locale } from "../i18n/utils";
import { entryPath, type WritingEntry } from "../lib/writing";
import { notePreview } from "../lib/note-preview";
import NoteLocation from "./NoteLocation.astro";
interface Props {
  entry: WritingEntry;
  locale: Locale;
  compact?: boolean;
}
const { entry, locale, compact = false } = Astro.props;
const limit = compact
  ? locale === "zh-CN"
    ? 180
    : 320
  : locale === "zh-CN"
    ? 300
    : 600;
const preview = notePreview(entry.body, limit, entry.data.cover);
const images = preview.images.slice(0, compact ? 3 : 6);
const remaining = preview.imageCount - images.length;
const columns =
  images.length === 1 ? 1 : images.length === 2 || images.length === 4 ? 2 : 3;
const href = entryPath(entry);
const dateLabel = entry.data.date.toLocaleString(
  locale === "zh-CN" ? "zh-CN" : "en-GB",
  {
    timeZone: "Asia/Hong_Kong",
    year: "numeric",
    month: "short",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  },
);
---

<article class:list={["note-card", { "note-card--compact": compact }]}>
  <header class="note-card__meta">
    <span>{entry.data.author}</span>
    <a href={href} aria-label={`${entry.data.title} · ${dateLabel}`}>
      <time datetime={entry.data.date.toISOString()}>{dateLabel}</time>
    </a>
  </header>
  {preview.text && <p class="note-card__preview">{preview.text}</p>}
  {
    images.length > 0 && (
      <div
        class:list={[
          "note-card__gallery",
          { "note-card__gallery--single": images.length === 1 },
        ]}
        style={`--note-columns: ${columns}`}
      >
        {images.map((image, index) => (
          <a
            class="note-card__image"
            href={href}
            aria-label={
              locale === "zh-CN"
                ? `查看随记中的照片（${index + 1}/${preview.imageCount}）`
                : `View note photos (${index + 1}/${preview.imageCount})`
            }
          >
            <img
              src={image.src}
              alt={image.alt ?? ""}
              loading="lazy"
              decoding="async"
              width="400"
              height="400"
            />
            {index === images.length - 1 && remaining > 0 && (
              <span class="note-card__more" aria-hidden="true">
                +{remaining}
              </span>
            )}
          </a>
        ))}
      </div>
    )
  }
  <NoteLocation
    name={entry.data.location}
    href={entry.data.locationUrl}
    locale={locale}
  />
  <div>
    <a class="note-card__link" href={href}>
      {locale === "zh-CN" ? "查看全文" : "Read full note"}
      {
        preview.imageCount > 0 && (
          <span>
            {" "}
            ·{" "}
            {locale === "zh-CN"
              ? `全部 ${preview.imageCount} 张照片`
              : `${preview.imageCount} ${preview.imageCount === 1 ? "photo" : "photos"}`}
          </span>
        )
      }
    </a>
  </div>
</article>

<style>
  .note-card {
    min-width: 0;
    padding-block: 1.75rem;
  }
  .note-card + .note-card {
    border-top: 1px solid var(--line);
  }
  .note-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: baseline;
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .note-card__meta > span {
    color: var(--ink);
    font-weight: 600;
  }
  .note-card__meta a:hover {
    color: var(--accent);
  }
  .note-card__preview {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 8;
    overflow: hidden;
    white-space: pre-line;
    overflow-wrap: anywhere;
    color: var(--ink);
    line-height: 1.85;
  }
  .note-card__gallery {
    display: grid;
    grid-template-columns: repeat(var(--note-columns), minmax(0, 1fr));
    gap: 0.5rem;
    max-width: 34rem;
    margin-top: 1rem;
  }
  .note-card__image {
    display: block;
    position: relative;
    min-width: 0;
    aspect-ratio: 1;
    border-radius: 0.5rem;
    background: var(--surface-soft);
  }
  .note-card__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }
  .note-card__gallery--single {
    max-width: 24rem;
  }
  .note-card__gallery--single .note-card__image {
    aspect-ratio: 3 / 2;
  }
  .note-card__gallery--single img {
    object-fit: contain;
  }
  .note-card__more {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: inherit;
    color: white;
    background: rgb(0 0 0 / 0.6);
    font-size: 1.5rem;
    font-weight: 600;
  }
  .note-card--compact {
    padding: 0;
  }
  .note-card--compact .note-card__preview {
    -webkit-line-clamp: 5;
  }
  .note-card--compact .note-card__gallery {
    max-width: 25rem;
  }
  .note-card--compact .note-card__gallery--single {
    max-width: 19.5rem;
  }
  .note-card__link {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25em;
    min-height: 2.75rem;
    margin-top: 0.25rem;
    padding-block: 0.5rem;
    color: var(--accent);
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
