---
import "../styles/section-atmosphere.css";

interface Props {
  kind: "lines" | "light" | "orbit";
}
const { kind } = Astro.props;
---

<div
  class:list={["section-atmosphere", `section-atmosphere--${kind}`]}
  data-scenery
  data-active="false"
  aria-hidden="true"
>
  <div class="scene-field">
    {
      kind === "lines" && (
        <svg
          viewBox="0 0 520 100"
          fill="none"
          stroke="currentColor"
          focusable="false"
        >
          <path
            class="scene-line-base"
            d="M10 72C100 72 125 18 240 30S400 90 510 26"
          />
          <path
            class="scene-line-trace"
            pathLength="1"
            d="M10 72C100 72 125 18 240 30S400 90 510 26"
          />
          <path
            class="scene-line-echo"
            d="M10 86C100 86 125 32 240 44S400 104 510 40"
          />
        </svg>
      )
    }
    {
      kind === "light" && (
        <>
          <span class="scene-light scene-light--day" />
          <span class="scene-light scene-light--warm" />
        </>
      )
    }
    {
      kind === "orbit" && (
        <svg
          viewBox="0 0 360 280"
          fill="none"
          stroke="currentColor"
          focusable="false"
        >
          <g class="scene-orbit-ring">
            <ellipse cx="180" cy="140" rx="154" ry="74" />
            <circle cx="334" cy="140" r="4" fill="currentColor" stroke="none" />
          </g>
          <g class="scene-orbit-ring scene-orbit-ring--inner">
            <ellipse cx="180" cy="140" rx="118" ry="52" />
            <circle cx="62" cy="140" r="3" fill="currentColor" stroke="none" />
          </g>
        </svg>
      )
    }
  </div>
</div>
