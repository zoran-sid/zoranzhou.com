---
import type { TicketType } from "../lib/ticket-model";
interface Props {
  type: TicketType;
}
const { type } = Astro.props;
const paths: Partial<Record<TicketType, string>> = {
  movie:
    "M4 4h16v16H4zM8 4v16M16 4v16M4 8h4M4 12h4M4 16h4M16 8h4M16 12h4M16 16h4",
  concert:
    "M9 17V5l11-2v12M9 8l11-2M9 17c0 2-2 4-4 4s-3-1-3-2 2-3 4-3 3 0 3 1ZM20 15c0 2-2 4-4 4s-3-1-3-2 2-3 4-3 3 0 3 1Z",
  train:
    "M5 16V6q0-3 7-3t7 3v10q0 3-7 3t-7-3ZM5 11h14M12 3v8M8 15h.01M16 15h.01M8 19l-3 3M16 19l3 3",
  flight: "m3 15 7-5V4q2-4 4 0v6l7 5v2l-7-2v4l2 2v1l-4-1-4 1v-1l2-2v-4l-7 2z",
  exhibition: "M3 4h18v16H3zM3 16l6-6 4 4 3-3 5 5M16 7h.01",
  sport:
    "M7 3h10v5q0 7-5 7T7 8ZM7 5H3v3q0 4 5 4M17 5h4v3q0 4-5 4M12 15v5M7 21h10",
  receipt: "M5 3h14v18l-2-1-2 1-3-1-3 1-2-1-2 1ZM8 7h8M8 11h8M8 15h4",
  travel: "M3 5l6-2 6 2 6-2v16l-6 2-6-2-6 2ZM9 3v16M15 5v16",
};
const key = type === "dining" || type === "invoice" ? "receipt" : type;
const path =
  paths[key] ??
  "M3 6h18v4a2 2 0 0 0 0 4v4H3v-4a2 2 0 0 0 0-4ZM16 6v2m0 2v2m0 2v2m0 2v0";
---

<svg
  class="ticket-icon"
  viewBox="0 0 24 24"
  width="28"
  height="28"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"><path d={path}></path></svg
>
