---
import type { TicketType } from "../lib/ticket-model";
interface Props {
  /** Every type except movie, which uses the wallet pass instead. */
  type: Exclude<TicketType, "movie">;
  /** Unique per card so gradient ids never collide on a page of tickets. */
  uid: string;
}
const { type, uid } = Astro.props;
const family = ["theatre", "performance", "comedy"].includes(type)
  ? "stage"
  : ["receipt", "dining", "invoice"].includes(type)
    ? "receipt"
    : type;
const id = (name: string) => `ticket-${uid}-${name}`;
const url = (name: string) => `url(#${id(name)})`;
// Deterministic geometry shared by every card of the same family.
const bars = Array.from({ length: 21 }, (_, index) => ({
  x: 6 + index * 14,
  h:
    26 +
    Math.round(40 * Math.abs(Math.sin(index * 1.7) * Math.cos(index * 0.6))),
}));
const grooves = [62, 55, 48, 41, 34];
const scallops = Array.from({ length: 10 }, (_, index) => index * 30);
const valance = scallops.map((x) => `Q${285 - x} 46 ${270 - x} 26`).join("");
const stripes = Array.from({ length: 10 }, (_, index) => index * 30);
const ties = [0, 1, 2, 3, 4, 5, 6].map((index) => {
  const t = Math.pow(index / 6, 1.6);
  return { y: 136 + t * 64, half: 8 + t * 82 };
});
const barcode: { x: number; w: number }[] = [];
let barX = 116;
[2, 1, 1, 3, 1, 2, 1, 1, 2, 3, 1, 1, 2, 1, 3, 1, 2, 1].forEach((w, index) => {
  if (index % 2 === 0) barcode.push({ x: barX, w: w * 2 });
  barX += w * 2;
});
const stampHoles = Array.from({ length: 9 }, (_, index) => 92 + index * 14.5);
---

<svg
  class="ticket-art"
  viewBox="0 0 300 200"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
>
  {
    family === "concert" ? (
      <>
        <defs>
          <linearGradient id={id("dusk")} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#2a1f5c" />
            <stop offset="0.55" stop-color="#e2457a" />
            <stop offset="1" stop-color="#f6a85f" />
          </linearGradient>
        </defs>
        <rect width="300" height="200" fill={url("dusk")} />
        <g fill="#fff3e6" opacity="0.8">
          <circle cx="40" cy="26" r="1.6" />
          <circle cx="92" cy="14" r="1.2" />
          <circle cx="210" cy="22" r="1.6" />
          <circle cx="262" cy="40" r="1.2" />
          <circle cx="150" cy="10" r="1" />
        </g>
        {bars.map((bar) => (
          <rect
            x={bar.x}
            y={200 - bar.h}
            width="9"
            height={bar.h}
            rx="2"
            fill="#ffe1ec"
            opacity="0.35"
          />
        ))}
        <circle cx="150" cy="150" r="70" fill="#15102a" />
        {grooves.map((r) => (
          <circle
            cx="150"
            cy="150"
            r={r}
            fill="none"
            stroke="#43397a"
            stroke-width="1"
          />
        ))}
        <path
          d="M104 112a62 62 0 0 1 40-24"
          fill="none"
          stroke="#ffe1ec"
          stroke-opacity="0.45"
          stroke-width="2"
          stroke-linecap="round"
        />
        <circle cx="150" cy="150" r="22" fill="#ffd166" />
        <circle cx="150" cy="150" r="13" fill="none" stroke="#e2457a" />
        <circle cx="150" cy="150" r="3.5" fill="#15102a" />
      </>
    ) : family === "stage" ? (
      <>
        <rect width="300" height="200" fill="#24433a" />
        <path d="M118 0h64l58 184H60z" fill="#fff4dc" opacity="0.1" />
        <ellipse
          cx="150"
          cy="182"
          rx="88"
          ry="12"
          fill="#fff4dc"
          opacity="0.28"
        />
        <rect y="184" width="300" height="16" fill="#3b2a22" />
        <path d="M0 0h112c-8 56-22 118-58 184H0z" fill="#8c2b4a" />
        <path d="M300 0H188c8 56 22 118 58 184h54z" fill="#8c2b4a" />
        <path
          d="M28 20c-4 60-10 110-24 164M58 20c-6 56-16 108-34 164M86 20c-8 52-20 100-42 164M272 20c4 60 10 110 24 164M242 20c6 56 16 108 34 164M214 20c8 52 20 100 42 164"
          fill="none"
          stroke="#5e1a31"
          stroke-width="2"
        />
        <path d={`M0 0H300V26${valance}Z`} fill="#8c2b4a" />
        <path
          d={`M300 26${valance}`}
          fill="none"
          stroke="#e0b252"
          stroke-width="3"
        />
        <circle cx="150" cy="96" r="14" fill="#e0b252" />
        <path d="m150 86 3 7h7l-6 4 2 7-6-4-6 4 2-7-6-4h7z" fill="#24433a" />
      </>
    ) : family === "exhibition" ? (
      <>
        <rect width="300" height="200" fill="#ece4d4" />
        <circle cx="112" cy="100" r="64" fill="#2f5fb3" />
        <rect x="150" y="34" width="112" height="72" fill="#e8b23a" />
        <path d="m168 176 46-86 46 86z" fill="#d2603a" />
        <path d="M24 176h252" stroke="#1d2529" stroke-width="3" />
        <circle cx="252" cy="148" r="9" fill="#1d2529" />
        <path d="M40 40h40" stroke="#1d2529" stroke-width="3" />
      </>
    ) : family === "sport" ? (
      <>
        {stripes.map((x, index) => (
          <rect
            x={x}
            width="30"
            height="200"
            fill={index % 2 ? "#2f8f5b" : "#38a067"}
          />
        ))}
        <g fill="none" stroke="#f4fff6" stroke-width="2.5" opacity="0.92">
          <rect x="16" y="14" width="268" height="148" />
          <path d="M150 14v148M16 52h40v72H16M284 52h-40v72h40" />
          <circle cx="150" cy="88" r="30" />
        </g>
        <circle cx="150" cy="88" r="3" fill="#f4fff6" />
        <rect y="170" width="300" height="30" fill="#d9734e" />
        <path
          d="M0 180h300M0 190h300"
          stroke="#fff3ea"
          stroke-width="1.5"
          stroke-dasharray="14 8"
        />
      </>
    ) : family === "train" ? (
      <>
        <defs>
          <linearGradient id={id("dawn")} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#9fc4e8" />
            <stop offset="1" stop-color="#f7dccb" />
          </linearGradient>
        </defs>
        <rect width="300" height="200" fill={url("dawn")} />
        <circle cx="214" cy="74" r="24" fill="#f6b26b" />
        <path
          d="M0 112c48-30 92-34 140-14s98 18 160-16v118H0z"
          fill="#6f9cc6"
        />
        <path d="M0 136c60-22 120-22 180-8s90 10 120 0v72H0z" fill="#3e6f9c" />
        <path
          d="M60 200 146 132M240 200l-86-68"
          stroke="#1f3550"
          stroke-width="3"
        />
        {ties.map((tie) => (
          <path
            d={`M${150 - tie.half} ${tie.y}h${tie.half * 2}`}
            stroke="#1f3550"
            stroke-width={1 + tie.y / 90}
          />
        ))}
        <rect x="118" y="112" width="64" height="18" rx="5" fill="#c2453a" />
        <path
          d="M126 117h10v6h-10zm16 0h10v6h-10zm16 0h10v6h-10z"
          fill="#fde9d9"
        />
      </>
    ) : family === "flight" ? (
      <>
        <defs>
          <linearGradient id={id("sky")} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#4f9fe0" />
            <stop offset="1" stop-color="#ffd6a5" />
          </linearGradient>
        </defs>
        <rect width="300" height="200" fill={url("sky")} />
        <g fill="#ffffff" opacity="0.9">
          <circle cx="62" cy="150" r="18" />
          <circle cx="86" cy="140" r="24" />
          <circle cx="114" cy="152" r="16" />
          <rect x="44" y="150" width="86" height="18" rx="9" />
          <circle cx="226" cy="58" r="11" />
          <circle cx="242" cy="50" r="15" />
          <rect x="214" y="56" width="50" height="12" rx="6" />
        </g>
        <path
          d="M28 176C90 70 170 40 236 92"
          fill="none"
          stroke="#ffffff"
          stroke-width="2"
          stroke-dasharray="5 7"
          stroke-linecap="round"
        />
        <path
          d="m3 15 7-5V4q2-4 4 0v6l7 5v2l-7-2v4l2 2v1l-4-1-4 1v-1l2-2v-4l-7 2z"
          transform="translate(242 96) rotate(128) scale(1.9) translate(-12 -12)"
          fill="#ffffff"
        />
      </>
    ) : family === "travel" ? (
      <>
        <rect width="300" height="200" fill="#fbe3c4" />
        <circle cx="206" cy="70" r="30" fill="#f28f4b" />
        <path d="M0 150 70 64l46 50 40-36 72 72z" fill="#2a7f74" />
        <path d="m120 150 74-82 106 82z" fill="#1f5d57" />
        <path d="m70 64 16 19-14-6-12 9z" fill="#fbf1e2" />
        <rect y="148" width="300" height="52" fill="#5fb0c9" />
        <path
          d="M10 166q10-6 20 0t20 0 20 0M110 182q10-6 20 0t20 0 20 0M200 164q10-6 20 0t20 0 20 0"
          fill="none"
          stroke="#eaf7fb"
          stroke-width="2"
          stroke-linecap="round"
        />
        <path
          d="M60 34q6-6 12 0 6-6 12 0M100 48q5-5 10 0 5-5 10 0"
          fill="none"
          stroke="#2b3b36"
          stroke-width="1.6"
          stroke-linecap="round"
        />
      </>
    ) : family === "receipt" ? (
      <>
        <rect width="300" height="200" fill="#cfe9dd" />
        <circle cx="54" cy="46" r="22" fill="#f4c95d" opacity="0.8" />
        <circle cx="252" cy="160" r="30" fill="#3c8d6c" opacity="0.25" />
        <path
          d="M98 14h104v164l-8.7 6-8.6-6-8.7 6-8.7-6-8.6 6-8.7-6-8.7 6-8.6-6-8.7 6-8.7-6-8.6 6-8.7-6z"
          fill="#fffdf7"
        />
        <g fill="#2a2a2a">
          <rect x="114" y="30" width="72" height="5" rx="2" />
          <rect x="114" y="46" width="40" height="3" rx="1.5" opacity="0.5" />
          <rect x="166" y="46" width="20" height="3" rx="1.5" opacity="0.5" />
          <rect x="114" y="58" width="48" height="3" rx="1.5" opacity="0.5" />
          <rect x="172" y="58" width="14" height="3" rx="1.5" opacity="0.5" />
          <rect x="114" y="70" width="34" height="3" rx="1.5" opacity="0.5" />
          <rect x="166" y="70" width="20" height="3" rx="1.5" opacity="0.5" />
          <rect x="114" y="92" width="30" height="5" rx="2" />
          <rect x="160" y="92" width="26" height="5" rx="2" />
        </g>
        <path
          d="M114 84h72"
          stroke="#2a2a2a"
          stroke-width="1"
          stroke-dasharray="2 3"
          opacity="0.5"
        />
        {barcode.map((bar) => (
          <rect x={bar.x} y="132" width={bar.w} height="26" fill="#2a2a2a" />
        ))}
      </>
    ) : (
      <>
        <rect width="300" height="200" fill="#e7d8bd" />
        <rect x="84" y="34" width="132" height="132" fill="#fffaf0" />
        {stampHoles.map((p) => (
          <>
            <circle cx={p} cy="34" r="4" fill="#e7d8bd" />
            <circle cx={p} cy="166" r="4" fill="#e7d8bd" />
            <circle cx="84" cy={p - 50} r="4" fill="#e7d8bd" />
            <circle cx="216" cy={p - 50} r="4" fill="#e7d8bd" />
          </>
        ))}
        <rect x="98" y="48" width="104" height="104" fill="#2c7a7b" />
        <circle cx="150" cy="100" r="30" fill="#f4c95d" />
        <path d="M150 62v76M112 100h76" stroke="#fffaf0" stroke-width="2" />
        <circle
          cx="214"
          cy="66"
          r="34"
          fill="none"
          stroke="#7a3e2b"
          stroke-width="2.5"
          opacity="0.7"
        />
        <path
          d="M196 116q14-8 28 0t28 0 28 0M196 130q14-8 28 0t28 0 28 0M196 144q14-8 28 0t28 0 28 0"
          fill="none"
          stroke="#7a3e2b"
          stroke-width="2.5"
          opacity="0.7"
        />
      </>
    )
  }
</svg>
