---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n/utils";
import { entryPath } from "../lib/writing";
import TicketFace from "./TicketFace.astro";
import "../styles/tickets.css";
interface Props {
  ticket: CollectionEntry<"tickets">;
  locale: Locale;
  heading?: "h2" | "h3";
}
const { ticket, locale, heading: Heading = "h2" } = Astro.props;
const { type } = ticket.data;
---

<a class="ticket-card" href={entryPath(ticket)} data-type={type}>
  <TicketFace ticket={ticket} locale={locale} heading={Heading} />
</a>
