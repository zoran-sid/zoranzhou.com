---
import { COPYRIGHT, SOCIAL_LINKS, SOCIAL_ICONS } from "../lib/constants";
import { editorial } from "../i18n/editorial";
import { localizePath, type Locale } from "../i18n/utils";
import "../styles/footer.css";
const locale = (Astro.currentLocale ?? "zh-CN") as Locale;
const zh = locale === "zh-CN";
const c = editorial(locale);
const footerLinks = [
  { label: "Blog", href: "/blog" },
  { label: "Essays", href: "/blog/formats/essay" },
  { label: zh ? "随记" : "Notes", href: "/blog/formats/note" },
  { label: zh ? "项目" : "Projects", href: "/projects" },
  { label: "Web3 Lab", href: "/lab" },
  { label: zh ? "生活" : "Life", href: "/life" },
  { label: zh ? "票根" : "Ticket Box", href: "/tickets" },
  { label: zh ? "书架" : "Library", href: "/library" },
  { label: zh ? "摄影" : "Photography", href: "/photos" },
  { label: zh ? "足迹" : "Journeys", href: "/map" },
  { label: zh ? "影视与游戏" : "Films & games", href: "/media" },
  { label: "Now", href: "/now" },
  { label: "About", href: "/about" },
];
---

<footer class="site-footer" id="contact">
  <div class="page-container">
    <div class="footer-layout">
      <div class="footer-primary">
        <div class="footer-contact">
          <div>
            <h2>{zh ? "联络" : "Keep in touch"}</h2><p>{c.contactDeck}</p>
          </div>
        </div>
        <div class="footer-connect">
          <a class="subscribe-pill" href={localizePath("/subscribe", locale)}>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
              ><circle cx="5" cy="19" r="1.3" fill="currentColor"></circle><path
                d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"></path></svg
            >
            {c.subscribe}
          </a>
          <nav
            class="footer-socials"
            aria-label={zh ? "社交主页" : "Social profiles"}
          >
            {
              SOCIAL_LINKS.filter(
                (link) => link.url !== "#",
              ).map((link) => (
                <a
                  href={link.url}
                  target={link.url.startsWith("mailto:") ? undefined : "_blank"}
                  rel={
                    link.url.startsWith("mailto:")
                      ? undefined
                      : "noopener noreferrer"
                  }
                  aria-label={link.label}
                  title={link.label}
                >
                  {link.name === "instagram" ? (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      aria-hidden="true"
                    >
                      <rect x="3" y="3" width="18" height="18" rx="5" />
                      <circle cx="12" cy="12" r="4" />
                      <circle cx="17.5" cy="6.5" r=".8" fill="currentColor" />
                    </svg>
                  ) : (
                    <span
                      aria-hidden="true"
                      set:html={SOCIAL_ICONS[link.name]}
                    />
                  )}
                </a>
              ))
            }
          </nav>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Zoran Zhou</span><a
            href={COPYRIGHT.licenseUrl}
            target="_blank"
            rel="noopener noreferrer">{COPYRIGHT.license}</a
          >
        </div>
      </div>
      <nav
        class="footer-directory"
        aria-label={zh ? "网站目录" : "Site directory"}
      >
        {
          footerLinks.map((link) => (
            <a href={localizePath(link.href, locale)}>{link.label}</a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
