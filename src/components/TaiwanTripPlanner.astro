---
import { taiwanPlans as plans } from "../data/taiwan-trip";
const first = plans[0];
---

<section
  class="tw-planner"
  data-tw-planner
  data-plans={JSON.stringify(plans)}
  aria-label="台湾旅行计划"
>
  <header class="tw-topbar">
    <div><h2>把路线摊开来看</h2><p data-plan-summary>{first.summary}</p></div>
    <div class="tw-plan-switch" role="group" aria-label="选择旅行方案">
      {
        plans.map((plan, i) => (
          <button type="button" data-plan={plan.id} aria-pressed={i === 0}>
            {plan.label}
          </button>
        ))
      }
    </div>
  </header>
  <div class="tw-trip-meta">
    <span data-plan-range>{first.range}</span><span data-plan-nights
      >{first.nights}</span
    >
    <a
      href="https://www.google.com/maps/dir/Taiwan+Taoyuan+International+Airport/Taipei+Main+Station/Alishan+National+Forest+Recreation+Area/Tainan+Station/Kaohsiung+Station/Kaohsiung+International+Airport/"
      target="_blank"
      rel="noopener noreferrer">全程地点总览 ↗</a
    >
  </div>
  <div class="tw-mobile-view" role="group" aria-label="切换行程或地图">
    <button type="button" data-view="list" aria-pressed="true">查看行程</button
    ><button type="button" data-view="map" aria-pressed="false">查看地图</button
    >
  </div>
  <div class="tw-workspace" data-workspace data-view="list">
    <nav class="tw-day-rail" aria-label="按天查看路线">
      {
        plans.map((plan, p) => (
          <div
            data-plan-rail={plan.id}
            hidden={p !== 0}
            role="tablist"
            aria-label={`${plan.label}日期`}
          >
            {plan.days.map((day, i) => (
              <button
                type="button"
                id={`tw-tab-${plan.id}-${day.id}`}
                data-day={day.id}
                role="tab"
                aria-selected={i === 0}
                aria-controls={`tw-panel-${plan.id}-${day.id}`}
                tabindex={i === 0 ? 0 : -1}
              >
                <span>
                  D{day.id}
                  <small>{day.date}</small>
                </span>
                <strong>{day.base}</strong>
              </button>
            ))}
          </div>
        ))
      }
    </nav>
    <div class="tw-day-content" data-day-content>
      {
        plans.map((plan, p) =>
          plan.days.map((day, i) => (
            <section
              class="tw-day-panel"
              id={`tw-panel-${plan.id}-${day.id}`}
              data-panel-plan={plan.id}
              data-panel-day={day.id}
              role="tabpanel"
              aria-labelledby={`tw-tab-${plan.id}-${day.id}`}
              hidden={p !== 0 || i !== 0}
              tabindex="0"
            >
              <header class="tw-day-heading">
                <>
                  <p class="tw-day-date">
                    {day.date} · {day.pace}
                  </p>
                  <h3>{day.name}</h3>
                  <p>{day.route}</p>
                </>
              </header>
              <p class="tw-day-note">{day.note}</p>
              <ol class="tw-stops" aria-label="当天地点顺序">
                {day.stops.map((stop, n) => (
                  <li data-stop-row={n}>
                    <button
                      class="tw-stop-number"
                      type="button"
                      data-stop={n}
                      aria-label={`在地图定位：${stop.name}`}
                      title="在地图定位"
                    >
                      {n + 1}
                    </button>
                    <div>
                      <div class="tw-stop-meta">
                        <span>{stop.kind}</span>
                        <span>{stop.period}</span>
                      </div>
                      <h4>{stop.name}</h4>
                      <p>{stop.detail}</p>
                    </div>
                  </li>
                ))}
              </ol>
              <div class="tw-stay">
                <>
                  <span>今晚住哪</span>
                  <strong>{day.stay}</strong>
                </>
              </div>
              <div class="tw-legs">
                <>
                  <h4>分段导航与票务</h4>
                  <ul>
                    {day.legs.map((leg) => (
                      <li>
                        <a
                          href={leg.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {leg.label}
                          <span aria-hidden="true"> ↗</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <a
                    class="tw-preview"
                    href={day.previewUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Google Maps 地点顺序预览 ↗
                  </a>
                </>
              </div>
              <aside class="tw-culture">
                <>
                  <h4>{day.culture.title}</h4>
                  <p>{day.culture.body}</p>
                  <a
                    href={day.culture.source.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {day.culture.source.title} ↗
                  </a>
                </>
              </aside>
            </section>
          )),
        )
      }
    </div>
    <aside class="tw-map-column" aria-label="当天路线地图">
      <div class="tw-map-sticky">
        <div class="tw-map-heading">
          <strong data-map-title>D1 · 抵达与入住</strong><button
            type="button"
            data-fit-map>查看全日地点</button
          >
        </div>
        <div class="tw-map-wrap">
          <div data-tw-map class="tw-map" aria-label="当天地点交互地图"></div><p
            class="tw-map-loading"
            data-map-loading
          >
            正在载入地图…
          </p><p class="tw-map-error" data-map-error hidden>
            地图暂时无法载入。请使用行程中的分段导航链接。
          </p>
        </div>
        <p class="tw-map-caption">
          编号对应左侧地点。虚线只表示游览顺序，坐标为规划示意；乘车、步行请打开分段导航，山上列车另查官方公告。
        </p>
        <p class="tw-map-selection" data-map-selection aria-live="polite">
          选择地点编号，可在地图定位。
        </p>
      </div>
    </aside>
  </div>
  <noscript
    ><p class="tw-nojs">
      启用 JavaScript 可切换每日行程与地图；所有日期的导航链接也可在下方展开。
    </p></noscript
  >
  <details class="tw-all-links">
    <summary>展开两种方案的每日导航链接</summary>{
      plans.map((plan) => (
        <div>
          <>
            <h3>{plan.label}</h3>
            <ul>
              {plan.days.map((day) => (
                <li>
                  <strong>
                    D{day.id} · {day.date} · {day.name}
                  </strong>
                  <a
                    href={day.previewUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    地点预览 ↗
                  </a>
                  {day.legs.map((leg) => (
                    <a href={leg.url} target="_blank" rel="noopener noreferrer">
                      {leg.label} ↗
                    </a>
                  ))}
                </li>
              ))}
            </ul>
          </>
        </div>
      ))
    }
  </details>
  <section class="tw-budget" aria-labelledby="tw-budget-title">
    <div>
      <h3 id="tw-budget-title">算一算，这趟要花多少</h3><p>
        单人私人客房。切换方案会载入对应预算；按你的报价修改，1 港元按 NT$4.2
        粗算。
      </p>
    </div>
    <div class="tw-budget-fields">
      <label
        >往返机票（HK$）<input
          data-budget="flight"
          type="number"
          min="0"
          step="100"
          value={first.budget.flight}
          inputmode="decimal"
        /></label
      >
      <label
        ><span data-hotel-label>8晚住宿（NT$）</span><input
          data-budget="hotel"
          type="number"
          min="0"
          step="500"
          value={first.budget.hotel}
          inputmode="decimal"
        /></label
      >
      <label
        ><span data-food-label>9天餐饮（NT$）</span><input
          data-budget="food"
          type="number"
          min="0"
          step="100"
          value={first.budget.food}
          inputmode="decimal"
        /></label
      >
      <label
        >额外开销（HK$）<input
          data-budget="extra"
          type="number"
          min="0"
          step="100"
          value="0"
          inputmode="decimal"
        /></label
      >
    </div>
    <div class="tw-budget-total">
      <p>
        另预留交通 NT$3,000、门票活动 NT$1,600、应急
        NT$1,500。宅配、计程车与超出部分填入额外开销。这些是规划数值，房价和机票以订单报价为准。
      </p><output data-total aria-live="polite">约 HK$10,276</output>
    </div>
  </section>
</section>

<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  import type { TaiwanPlan } from "../data/taiwan-trip";
  const root = document.querySelector<HTMLElement>("[data-tw-planner]");
  if (root) {
    const plans: TaiwanPlan[] = JSON.parse(root.dataset.plans ?? "[]");
    let plan = plans[0];
    let day = plan.days[0];
    let map: maplibregl.Map | undefined;
    let ready = false;
    let markers: maplibregl.Marker[] = [];
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const qa = <T extends Element>(s: string) =>
      Array.from(root.querySelectorAll<T>(s));
    const motion = () =>
      window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 450;
    const panel = () => q<HTMLElement>(`#tw-panel-${plan.id}-${day.id}`);
    function focusStop(index: number, move = true) {
      const stop = day.stops[index];
      if (!stop) return;
      panel()
        .querySelectorAll<HTMLElement>("[data-stop-row]")
        .forEach((row) =>
          row.classList.toggle(
            "is-active",
            Number(row.dataset.stopRow) === index,
          ),
        );
      markers.forEach((marker, n) => {
        marker.getElement().classList.toggle("is-active", n === index);
        if (n !== index) marker.getPopup()?.remove();
      });
      q<HTMLElement>("[data-map-selection]").textContent =
        `${index + 1}. ${stop.name}`;
      if (map && ready) {
        if (move)
          map.easeTo({
            center: stop.xy,
            zoom: Math.max(map.getZoom(), 13),
            duration: motion(),
          });
        if (!markers[index].getPopup()?.isOpen()) markers[index].togglePopup();
      }
    }
    function fitDay() {
      if (!map || !ready) return;
      const bounds = new maplibregl.LngLatBounds();
      day.stops.forEach((stop) => bounds.extend(stop.xy));
      map.fitBounds(bounds, { padding: 55, maxZoom: 13, duration: motion() });
    }
    function drawDay() {
      if (!map || !ready) return;
      (map.getSource("tw-route") as maplibregl.GeoJSONSource).setData({
        type: "Feature",
        properties: {},
        geometry: {
          type: "LineString",
          coordinates: day.stops.map((stop) => stop.xy),
        },
      });
      markers.forEach((marker) => marker.remove());
      markers = day.stops.map((stop, index) => {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.className = "tw-map-pin";
        dot.textContent = String(index + 1);
        dot.setAttribute("aria-label", `${index + 1}. ${stop.name}`);
        const marker = new maplibregl.Marker({ element: dot })
          .setLngLat(stop.xy)
          .setPopup(new maplibregl.Popup({ offset: 22 }).setText(stop.name))
          .addTo(map!);
        // MapLibre toggles the popup on marker click; let that event run before synchronising the list.
        dot.addEventListener("click", () =>
          requestAnimationFrame(() => focusStop(index, false)),
        );
        return marker;
      });
      fitDay();
    }
    function selectDay(id: number) {
      day = plan.days.find((item) => item.id === id) ?? plan.days[0];
      qa<HTMLButtonElement>(`[data-plan-rail="${plan.id}"] [data-day]`).forEach(
        (button) => {
          const active = Number(button.dataset.day) === day.id;
          button.setAttribute("aria-selected", String(active));
          button.tabIndex = active ? 0 : -1;
        },
      );
      qa<HTMLElement>("[data-panel-plan]").forEach(
        (item) =>
          (item.hidden =
            item.dataset.panelPlan !== plan.id ||
            Number(item.dataset.panelDay) !== day.id),
      );
      qa<HTMLElement>("[data-stop-row]").forEach((item) =>
        item.classList.remove("is-active"),
      );
      q<HTMLElement>("[data-map-title]").textContent =
        `D${day.id} · ${day.name}`;
      q<HTMLElement>("[data-map-selection]").textContent =
        "选择地点编号，可在地图定位。";
      drawDay();
    }
    qa<HTMLButtonElement>("[data-day]").forEach((button) => {
      button.addEventListener("click", () =>
        selectDay(Number(button.dataset.day)),
      );
      button.addEventListener("keydown", (event) => {
        if (
          ![
            "ArrowLeft",
            "ArrowRight",
            "ArrowUp",
            "ArrowDown",
            "Home",
            "End",
          ].includes(event.key)
        )
          return;
        event.preventDefault();
        const buttons = qa<HTMLButtonElement>(
          `[data-plan-rail="${plan.id}"] [data-day]`,
        );
        const index = buttons.indexOf(button);
        const next =
          event.key === "Home"
            ? 0
            : event.key === "End"
              ? buttons.length - 1
              : (index +
                  (["ArrowRight", "ArrowDown"].includes(event.key)
                    ? 1
                    : buttons.length - 1)) %
                buttons.length;
        buttons[next].focus();
        selectDay(Number(buttons[next].dataset.day));
      });
    });
    qa<HTMLButtonElement>("[data-stop]").forEach((button) =>
      button.addEventListener("click", () =>
        focusStop(Number(button.dataset.stop)),
      ),
    );
    function updateBudget() {
      const value = (key: string) =>
        Math.max(
          0,
          Number(q<HTMLInputElement>(`[data-budget="${key}"]`).value) || 0,
        );
      const total =
        value("flight") +
        value("extra") +
        (value("hotel") + value("food") + 6100) / 4.2;
      q<HTMLOutputElement>("[data-total]").textContent =
        `约 HK$${Math.round(total).toLocaleString("en-US")}`;
    }
    qa<HTMLInputElement>("[data-budget]").forEach((input) =>
      input.addEventListener("input", updateBudget),
    );
    qa<HTMLButtonElement>("[data-plan]").forEach((button) =>
      button.addEventListener("click", () => {
        const next = plans.find((item) => item.id === button.dataset.plan);
        if (!next || next.id === plan.id) return;
        plan = next;
        qa<HTMLButtonElement>("[data-plan]").forEach((item) =>
          item.setAttribute(
            "aria-pressed",
            String(item.dataset.plan === plan.id),
          ),
        );
        qa<HTMLElement>("[data-plan-rail]").forEach(
          (item) => (item.hidden = item.dataset.planRail !== plan.id),
        );
        q<HTMLElement>("[data-plan-summary]").textContent = plan.summary;
        q<HTMLElement>("[data-plan-range]").textContent = plan.range;
        q<HTMLElement>("[data-plan-nights]").textContent = plan.nights;
        q<HTMLElement>("[data-hotel-label]").textContent =
          `${plan.days.length - 1}晚住宿（NT$）`;
        q<HTMLElement>("[data-food-label]").textContent =
          `${plan.days.length}天餐饮（NT$）`;
        for (const key of ["flight", "hotel", "food"] as const)
          q<HTMLInputElement>(`[data-budget="${key}"]`).value = String(
            plan.budget[key],
          );
        q<HTMLInputElement>('[data-budget="extra"]').value = "0";
        updateBudget();
        selectDay(1);
      }),
    );
    qa<HTMLButtonElement>("button[data-view]").forEach((button) =>
      button.addEventListener("click", () => {
        q<HTMLElement>("[data-workspace]").dataset.view = button.dataset.view;
        qa<HTMLButtonElement>("button[data-view]").forEach((item) =>
          item.setAttribute("aria-pressed", String(item === button)),
        );
        requestAnimationFrame(() => {
          map?.resize();
          fitDay();
        });
      }),
    );
    q<HTMLButtonElement>("[data-fit-map]").addEventListener("click", fitDay);
    const showError = () => {
      q<HTMLElement>("[data-map-loading]").hidden = true;
      q<HTMLElement>("[data-map-error]").hidden = false;
    };
    try {
      map = new maplibregl.Map({
        container: q<HTMLElement>("[data-tw-map]"),
        style: "https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json",
        center: [121.519, 25.052],
        zoom: 10,
        attributionControl: {},
      });
      map.addControl(
        new maplibregl.NavigationControl({ showCompass: false }),
        "top-right",
      );
      map.on("load", () => {
        if (!map) return;
        map.addSource("tw-route", {
          type: "geojson",
          data: { type: "FeatureCollection", features: [] },
        });
        map.addLayer({
          id: "tw-route-line",
          type: "line",
          source: "tw-route",
          paint: {
            "line-color": "#aa4b30",
            "line-width": 2.5,
            "line-dasharray": [2, 1.5],
          },
        });
        ready = true;
        q<HTMLElement>("[data-map-loading]").hidden = true;
        q<HTMLElement>("[data-map-error]").hidden = true;
        drawDay();
      });
      map.on("error", showError);
    } catch {
      showError();
    }
    updateBudget();
    // The map starts hidden in the mobile list view; resize when the viewport changes.
    const observer = new ResizeObserver(() => {
      map?.resize();
      fitDay();
    });
    observer.observe(q<HTMLElement>("[data-tw-map]"));
  }
</script>

<style is:global>
  .tw-planner {
    scroll-margin-top: 100px;
    --tw-accent: #a0442b;
    --tw-soft: color-mix(in srgb, var(--ink) 5%, var(--surface));
    color: var(--ink);
    margin: 2rem 0 3.5rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    overflow: clip;
    font-family: var(--font-body, sans-serif);
    font-size: 15px;
    line-height: 1.7;
  }
  .tw-planner :is(h2, h3, h4, p, ol, ul) {
    margin: 0;
  }
  .tw-planner :is(ol, ul) {
    padding: 0;
    list-style: none;
  }
  .tw-planner :is(li, li + li) {
    margin: 0;
    padding: 0;
  }
  .tw-planner :is(button, input) {
    font: inherit;
  }
  .tw-planner button {
    cursor: pointer;
    color: inherit;
  }
  .tw-planner :is(button, a, input, summary):focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .tw-planner [hidden] {
    display: none !important;
  }
  .tw-planner a {
    color: var(--accent);
    text-underline-offset: 4px;
  }
  .tw-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 28px 14px;
  }
  .tw-topbar h2 {
    border: 0;
    padding: 0;
    font-size: 26px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .tw-topbar p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 14px;
  }
  .tw-plan-switch {
    display: flex;
    flex-shrink: 0;
    padding: 4px;
    background: var(--tw-soft);
    border-radius: 9px;
  }
  .tw-plan-switch button,
  .tw-mobile-view button {
    min-height: 44px;
    border: 0;
    background: transparent;
    padding: 8px 13px;
    border-radius: 6px;
    font-size: 14px;
  }
  .tw-plan-switch button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--surface);
  }
  .tw-plan-switch button:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .tw-trip-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding: 0 28px 22px;
    color: var(--muted);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .tw-workspace {
    display: grid;
    grid-template-columns: 110px minmax(300px, 0.9fr) minmax(360px, 1.1fr);
    border-block: 1px solid var(--line);
    align-items: start;
  }
  .tw-day-rail {
    padding: 12px 8px;
    position: sticky;
    top: 88px;
  }
  .tw-day-rail button {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    width: 100%;
    border: 0;
    background: transparent;
    padding: 10px 12px;
    border-radius: 7px;
    text-align: left;
    margin: 2px 0;
  }
  .tw-day-rail button > span {
    font-size: 14px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .tw-day-rail small {
    margin-left: 6px;
    font-size: 11px;
    font-weight: 400;
  }
  .tw-day-rail strong {
    color: inherit;
    font-size: 12px;
    font-weight: 400;
  }
  .tw-day-rail button[aria-selected="true"] {
    background: var(--ink);
    color: var(--surface);
  }
  .tw-day-rail button:hover:not([aria-selected="true"]) {
    background: var(--tw-soft);
  }
  .tw-day-content {
    border-inline: 1px solid var(--line);
    min-width: 0;
  }
  .tw-day-panel {
    padding: 28px 24px;
  }
  .tw-day-date {
    font-size: 13px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .tw-day-heading h3 {
    font-size: 25px;
    line-height: 1.4;
    margin: 9px 0;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .tw-day-heading > p:last-child {
    font-size: 13px;
    color: var(--muted);
  }
  .tw-planner .tw-day-note {
    margin: 20px 0 26px;
    font-size: 14px;
    line-height: 1.85;
  }
  .tw-stops {
    counter-reset: stops;
  }
  .tw-planner .tw-stops li {
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 14px;
    position: relative;
    padding-bottom: 28px;
  }
  .tw-stops li:not(:last-child)::before {
