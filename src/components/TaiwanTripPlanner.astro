---
import { taiwanDays as days } from "../data/taiwan-trip";
---

<section
  class="tw-planner"
  data-tw-planner
  data-days={JSON.stringify(days)}
  aria-labelledby="tw-trip-title"
>
  <header class="tw-planner__intro">
    <div>
      <h2 id="tw-trip-title">七天路线，点开看每一天</h2>
      <p>
        台北进 ·
        高雄出。切换日期查看当天地点、顺序与分段导航；时间目标见每一天的备注。
      </p>
    </div>
    <a
      href="https://www.google.com/maps/dir/Taiwan+Taoyuan+International+Airport/Taipei+Main+Station/Alishan+National+Forest+Recreation+Area/Tainan+Station/Kaohsiung+Station/Kaohsiung+International+Airport/"
      target="_blank"
      rel="noopener noreferrer">七天地点总览 ↗</a
    >
  </header>
  <div class="tw-planner__tabs" role="tablist" aria-label="选择行程日期">
    {
      days.map((day, i) => (
        <button
          id={`tw-day-${day.id}`}
          type="button"
          class:list={["tw-planner__tab", { "is-selected": i === 0 }]}
          role="tab"
          aria-selected={i === 0}
          aria-controls="tw-day-panel"
          tabindex={i === 0 ? 0 : -1}
          data-day={day.id}
        >
          <span class="tw-planner__tab-date">
            D{day.id} · {day.date}
          </span>
          <strong>{day.base}</strong>
        </button>
      ))
    }
  </div>
  <div
    class="tw-planner__detail"
    id="tw-day-panel"
    role="tabpanel"
    aria-labelledby="tw-day-1"
    tabindex="0"
  >
    <div class="tw-planner__detail-head">
      <span data-selected-day>D1 · 12/15</span><h3 data-selected-title>
        {days[0].name}
      </h3>
    </div>
    <p class="tw-planner__route" data-selected-route>{days[0].route}</p>
    <p data-selected-note>{days[0].note}</p>
    <a
      href={days[0].previewUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-selected-link>当天地点顺序预览 ↗</a
    >
    <ul class="tw-planner__legs" data-selected-legs aria-label="当天分段导航">
      {
        days[0].legs.map((leg) => (
          <li>
            <a href={leg.url} target="_blank" rel="noopener noreferrer">
              {leg.label} ↗
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="tw-planner__map-wrap">
    <div
      class="tw-planner__map"
      data-tw-map
      role="region"
      aria-label="台湾七日游交互地图：依次为桃园、台北、野柳、十分、九份、嘉义、阿里山、台南、高雄"
    >
    </div>
    <div class="tw-planner__map-fallback" data-tw-map-error hidden>
      在线地图暂时无法载入。上方每日路线和 Google 地图链接仍可使用。
    </div>
  </div>
  <p class="tw-planner__footnote">
    地点坐标为规划示意，橙色虚线表示当天顺序，含标注的可选点；它不是实际道路或铁路。整天链接仅作地点预览，实际乘车、步行请用分段导航并核对班次。
  </p>
  <details class="tw-planner__detail">
    <summary>七天 Google Maps 地点预览</summary>
    <p>
      这些链接用于查看地点顺序。铁路、客运、渡轮与步行请用每天的分段入口；观日列车按官方公告，不能按驾车路线进山。
    </p>
    <ul class="tw-planner__legs">
      {
        days.map((day) => (
          <li>
            <a href={day.previewUrl} target="_blank" rel="noopener noreferrer">
              D{day.id} · {day.date} · {day.name} ↗
            </a>
          </li>
        ))
      }
    </ul>
  </details>
  <div class="tw-planner__calc">
    <div class="tw-planner__calc-intro">
      <h3>自己算一次预算</h3>
      <p>
        单人、6 晚私人客房；交通与门票用规划预留值，汇率按 1 HKD ≈ NT$4.2 粗算。
      </p>
    </div>
    <div class="tw-planner__calc-grid">
      <label
        >机票合计 <output data-flight-output>HK$1,800</output><input
          data-flight
          type="range"
          min="1200"
          max="3400"
          step="100"
          value="1800"
        /></label
      >
      <label
        >6 晚住宿 <output data-hotel-output>NT$15,000</output><input
          data-hotel
          type="range"
          min="8500"
          max="24000"
          step="500"
          value="15000"
        /></label
      >
      <label
        >7 天餐饮 <output data-food-output>NT$3,500</output><input
          data-food
          type="range"
          min="2200"
          max="7000"
          step="100"
          value="3500"
        /></label
      >
    </div>
    <div class="tw-planner__total" aria-live="polite">
      <div><span>估算总花费</span><strong data-total>HK$7,657</strong></div><p>
        另固定预留 NT$6,100：台湾交通 3,000 / 景点及活动 1,600 / 应急
        1,500。行李宅配与额外叫车另计。
      </p>
    </div>
  </div>
</section>

<script>
  import maplibregl from "maplibre-gl";
  import "maplibre-gl/dist/maplibre-gl.css";
  import type { TaiwanDay } from "../data/taiwan-trip";
  const root = document.querySelector<HTMLElement>("[data-tw-planner]");
  if (root) {
    const days = JSON.parse(root.dataset.days!) as TaiwanDay[];
    const query = <T extends Element>(selector: string) =>
      root.querySelector<T>(selector);
    let map: maplibregl.Map | undefined;
    let ready = false;
    let selectedDay = days[0];
    let markers: maplibregl.Marker[] = [];
    const buttons = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-day]"),
    );
    function drawDay() {
      if (!map || !ready) return;
      const coordinates = selectedDay.stops.map((stop) => stop.xy);
      (map.getSource("tw-route") as maplibregl.GeoJSONSource).setData({
        type: "Feature",
        properties: {},
        geometry: { type: "LineString", coordinates },
      });
      markers.forEach((marker) => marker.remove());
      markers = selectedDay.stops.map((stop, index) => {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.className = "tw-planner__pin";
        dot.setAttribute("aria-label", `${index + 1}. ${stop.name}`);
        dot.title = `${index + 1}. ${stop.name}`;
        return new maplibregl.Marker({ element: dot })
          .setLngLat(stop.xy)
          .setPopup(
            new maplibregl.Popup({ offset: 18 }).setText(
              `${index + 1}. ${stop.name}`,
            ),
          )
          .addTo(map!);
      });
      const bounds = new maplibregl.LngLatBounds();
      coordinates.forEach((point) => bounds.extend(point));
      map.fitBounds(bounds, {
        padding: 45,
        maxZoom: 13,
        duration: window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ? 0
          : 650,
      });
    }
    function selectDay(id: number) {
      selectedDay = days.find((day) => day.id === id) ?? days[0];
      const day = selectedDay;
      buttons.forEach((button) => {
        const active = Number(button.dataset.day) === day.id;
        button.classList.toggle("is-selected", active);
        button.setAttribute("aria-selected", String(active));
        button.tabIndex = active ? 0 : -1;
      });
      query<HTMLElement>("[data-selected-day]")!.textContent =
        `D${day.id} · ${day.date}`;
      query<HTMLElement>("[data-selected-title]")!.textContent = day.name;
      query<HTMLElement>("[data-selected-route]")!.textContent = day.route;
      query<HTMLElement>("[data-selected-note]")!.textContent = day.note;
      query<HTMLAnchorElement>("[data-selected-link]")!.href = day.previewUrl;
      query<HTMLElement>("#tw-day-panel")!.setAttribute(
        "aria-labelledby",
        `tw-day-${day.id}`,
      );
      const list = query<HTMLElement>("[data-selected-legs]")!;
      list.replaceChildren(
        ...day.legs.map((leg) => {
          const item = document.createElement("li");
          const link = document.createElement("a");
          link.href = leg.url;
          link.textContent = `${leg.label} ↗`;
          link.target = "_blank";
          link.rel = "noopener noreferrer";
          item.append(link);
          return item;
        }),
      );
      drawDay();
    }
    buttons.forEach((button, index) => {
      button.addEventListener("click", () =>
        selectDay(Number(button.dataset.day)),
      );
      button.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key))
          return;
        event.preventDefault();
        const next =
          event.key === "Home"
            ? 0
            : event.key === "End"
              ? buttons.length - 1
              : event.key === "ArrowRight"
                ? (index + 1) % buttons.length
                : (index + buttons.length - 1) % buttons.length;
        buttons[next].focus();
        selectDay(Number(buttons[next].dataset.day));
      });
    });
    const flight = query<HTMLInputElement>("[data-flight]")!,
      hotel = query<HTMLInputElement>("[data-hotel]")!,
      food = query<HTMLInputElement>("[data-food]")!;
    const fmt = (value: number) => Math.round(value).toLocaleString("en-US");
    function updateBudget() {
      const f = Number(flight.value),
        h = Number(hotel.value),
        d = Number(food.value);
      query<HTMLElement>("[data-flight-output]")!.textContent = "HK$" + fmt(f);
      query<HTMLElement>("[data-hotel-output]")!.textContent = "NT$" + fmt(h);
      query<HTMLElement>("[data-food-output]")!.textContent = "NT$" + fmt(d);
      query<HTMLElement>("[data-total]")!.textContent =
        "HK$" + fmt(f + (h + d + 6100) / 4.2);
    }
    [flight, hotel, food].forEach((input) =>
      input.addEventListener("input", updateBudget),
    );
    updateBudget();
    const mapEl = query<HTMLElement>("[data-tw-map]");
    if (mapEl) {
      try {
        map = new maplibregl.Map({
          container: mapEl,
          style: "https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json",
          center: [121.519, 25.052],
          zoom: 10,
          attributionControl: {},
        });
        map.addControl(
          new maplibregl.NavigationControl({ showCompass: false }),
          "top-right",
        );
        map.on("load", () => {
          if (!map) return;
          map.addSource("tw-route", {
            type: "geojson",
            data: { type: "FeatureCollection", features: [] },
          });
          map.addLayer({
            id: "tw-route-line",
            type: "line",
            source: "tw-route",
            paint: {
              "line-color": "#b96335",
              "line-width": 2.6,
              "line-dasharray": [2, 1.5],
            },
          });
          ready = true;
          drawDay();
        });
        map.on("error", () => {
          query<HTMLElement>("[data-tw-map-error]")!.hidden = false;
        });
      } catch {
        query<HTMLElement>("[data-tw-map-error]")!.hidden = false;
      }
    }
  }
</script>

<style>
  .tw-planner {
    margin: 2.25rem 0 2.75rem;
    color: var(--ink, #25314a);
    border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface, #fff);
    font-family: inherit;
  }
  .tw-planner__intro {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem 1.5rem 0.8rem;
  }
  .tw-planner h2,
  .tw-planner h3,
  .tw-planner p {
    margin: 0;
  }
  .tw-planner h2 {
    font-size: 1.36rem;
    font-weight: 600;
  }
  .tw-planner__intro p,
  .tw-planner__calc-intro p {
    margin-top: 0.35rem;
    color: var(--muted, #566079);
    font-size: 0.92rem;
    line-height: 1.65;
  }
  .tw-planner a {
    color: var(--accent, #3e50a0);
    text-underline-offset: 3px;
  }
  .tw-planner__intro > a {
    font-size: 0.86rem;
    white-space: nowrap;
  }
  .tw-planner__tabs {
    display: flex;
    overflow-x: auto;
    padding: 0.45rem 1.5rem 0.65rem;
    gap: 0.35rem;
    scrollbar-width: thin;
  }
  .tw-planner__tab {
    min-width: 87px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    border: 1px solid transparent;
    border-radius: 10px;
    background: transparent;
    padding: 0.6rem 0.7rem;
    color: inherit;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }
  .tw-planner__tab:hover {
    background: color-mix(in srgb, currentColor 6%, transparent);
  }
  .tw-planner__tab.is-selected {
    background: color-mix(in srgb, var(--accent, #3e50a0) 10%, transparent);
    border-color: color-mix(in srgb, var(--accent, #3e50a0) 38%, transparent);
  }
  .tw-planner__tab-date {
    font-size: 0.76rem;
    color: var(--muted, #566079);
  }
  .tw-planner__tab strong {
    font-size: 0.95rem;
  }
  .tw-planner button:focus-visible,
  .tw-planner a:focus-visible,
  .tw-planner input:focus-visible {
    outline: 3px solid var(--accent, #3e50a0);
    outline-offset: 3px;
  }
  .tw-planner__detail {
    margin: 0.25rem 1.5rem 1rem;
    padding: 1rem 1.15rem;
    background: color-mix(
      in srgb,
      var(--accent, #3e50a0) 5%,
      var(--surface, #fff)
    );
    border-radius: 10px;
  }
  .tw-planner__detail-head {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .tw-planner__detail-head span {
    color: var(--muted, #566079);
    font-size: 0.8rem;
  }
  .tw-planner__detail h3 {
    font-size: 1.18rem;
    font-weight: 600;
  }
  .tw-planner__detail p {
    font-size: 0.91rem;
    line-height: 1.65;
    margin-top: 0.45rem;
  }
  .tw-planner__route {
    font-weight: 600;
  }
  .tw-planner__detail > a {
    font-size: 0.85rem;
    display: inline-block;
    margin-top: 0.6rem;
  }
  .tw-planner__map-wrap {
    position: relative;
    margin: 0 1.5rem;
  }
  .tw-planner__map {
    width: 100%;
    height: 410px;
    border-radius: 12px;
    background: #e7edee;
  }
  .tw-planner__map-fallback {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    padding: 0.85rem 1rem;
    background: #fff;
    color: #334155;
    border-radius: 10px;
    font-size: 0.87rem;
    box-shadow: 0 8px 20px #0002;
  }
  .tw-planner__footnote {
    padding: 0.55rem 1.5rem 1.3rem;
    color: var(--muted, #566079);
    font-size: 0.78rem;
    line-height: 1.6;
  }
  .tw-planner__calc {
    border-top: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    padding: 1.35rem 1.5rem 1.5rem;
  }
  .tw-planner__calc h3 {
    font-size: 1.2rem;
    font-weight: 600;
  }
  .tw-planner__calc-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .tw-planner__calc label {
    display: block;
    font-size: 0.83rem;
    line-height: 1.5;
  }
  .tw-planner__calc output {
    font-weight: 650;
    display: block;
    margin: 0.2rem 0 0.45rem;
    font-variant-numeric: tabular-nums;
  }
  .tw-planner__calc input {
    display: block;
    width: 100%;
    accent-color: var(--accent, #3e50a0);
    cursor: pointer;
  }
  .tw-planner__total {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.25rem;
    border-top: 1px solid color-mix(in srgb, currentColor 10%, transparent);
    margin-top: 1.1rem;
    padding-top: 1rem;
  }
  .tw-planner__total > div {
    display: grid;
    gap: 0.3rem;
    flex-shrink: 0;
  }
  .tw-planner__total span {
    font-size: 0.78rem;
    color: var(--muted, #566079);
  }
  .tw-planner__total strong {
    font-size: 1.85rem;
    letter-spacing: -0.025em;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }
  .tw-planner__total p {
    font-size: 0.78rem;
    color: var(--muted, #566079);
    max-width: 17rem;
    line-height: 1.55;
  }
  .tw-planner__legs {
    display: grid;
    gap: 0.45rem;
    padding-left: 1.1rem;
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }
  :global(.tw-planner__pin) {
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 100%;
    background: #a5512d;
    border: 2px solid #fff;
    box-shadow: 0 2px 7px #0005;
    cursor: pointer;
  }
  @media (max-width: 650px) {
    .tw-planner__intro {
      display: block;
      padding: 1.1rem 1rem 0.5rem;
    }
    .tw-planner__intro > a {
      display: inline-block;
      margin-top: 0.65rem;
    }
    .tw-planner__tabs {
      padding: 0.4rem 1rem 0.55rem;
    }
    .tw-planner__detail {
      margin: 0.2rem 1rem 0.85rem;
      padding: 0.85rem;
    }
    .tw-planner__map-wrap {
      margin: 0 1rem;
    }
    .tw-planner__map {
      height: 335px;
    }
    .tw-planner__footnote {
      padding: 0.5rem 1rem 1rem;
    }
    .tw-planner__calc {
      padding: 1rem;
    }
    .tw-planner__calc-grid {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
    .tw-planner__total {
      align-items: start;
      flex-direction: column;
      gap: 0.45rem;
    }
    .tw-planner__total strong {
      font-size: 1.65rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tw-planner__tab {
      transition: none;
    }
  }
</style>
