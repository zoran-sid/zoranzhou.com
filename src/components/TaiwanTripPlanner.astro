---
import {
  taiwanPlans as plans,
  TAIWAN_BUDGET_RESERVE,
} from "../data/taiwan-trip";
import { googleRoute } from "../lib/taiwan-maps";
const first = plans[0];
const firstRoute = googleRoute(first.days[0].legs[0].url)!;
---

<section
  class="tw-planner"
  data-tw-planner
  data-plans={JSON.stringify(plans)}
  data-budget-reserve={TAIWAN_BUDGET_RESERVE}
  aria-label="台湾旅行计划"
>
  <header class="tw-topbar">
    <div><h2>把路线摊开来看</h2><p data-plan-summary>{first.summary}</p></div>
    <div class="tw-plan-switch" role="group" aria-label="选择旅行方案">
      {
        plans.map((plan, i) => (
          <button type="button" data-plan={plan.id} aria-pressed={i === 0}>
            {plan.label}
          </button>
        ))
      }
    </div>
  </header>
  <div class="tw-trip-meta">
    <span data-plan-range>{first.range}</span><span data-plan-nights
      >{first.nights}</span
    >
    <a
      href="https://www.google.com/maps/dir/Taiwan+Taoyuan+International+Airport/Taipei+Main+Station/Tainan+Station/Kaohsiung+Station/Kaohsiung+International+Airport/"
      target="_blank"
      rel="noopener noreferrer">全程地点总览 ↗</a
    >
  </div>
  <div class="tw-mobile-view" role="group" aria-label="切换行程或地图">
    <button type="button" data-view="list" aria-pressed="true">查看行程</button
    ><button type="button" data-view="map" aria-pressed="false">查看地图</button
    >
  </div>
  <div class="tw-workspace" data-workspace data-view="list">
    <nav class="tw-day-rail" aria-label="按天查看路线">
      {
        plans.map((plan, p) => (
          <div
            data-plan-rail={plan.id}
            hidden={p !== 0}
            role="tablist"
            aria-label={`${plan.label}日期`}
          >
            {plan.days.map((day, i) => (
              <button
                type="button"
                id={`tw-tab-${plan.id}-${day.id}`}
                data-day={day.id}
                role="tab"
                aria-selected={i === 0}
                aria-controls={`tw-panel-${plan.id}-${day.id}`}
                tabindex={i === 0 ? 0 : -1}
              >
                <span>
                  D{day.id}
                  <small>{day.date}</small>
                </span>
                <strong>{day.base}</strong>
              </button>
            ))}
          </div>
        ))
      }
    </nav>
    <div class="tw-day-content" data-day-content>
      {
        plans.map((plan, p) =>
          plan.days.map((day, i) => (
            <section
              class="tw-day-panel"
              id={`tw-panel-${plan.id}-${day.id}`}
              data-panel-plan={plan.id}
              data-panel-day={day.id}
              role="tabpanel"
              aria-labelledby={`tw-tab-${plan.id}-${day.id}`}
              hidden={p !== 0 || i !== 0}
              tabindex="0"
            >
              <header class="tw-day-heading">
                <>
                  <p class="tw-day-date">
                    {day.date} · {day.pace}
                  </p>
                  <h3>{day.name}</h3>
                  <p>{day.route}</p>
                </>
              </header>
              <p class="tw-day-note">{day.note}</p>
              <ol class="tw-stops" aria-label="当天地点顺序">
                {day.stops.map((stop, n) => (
                  <li data-stop-row={n}>
                    <button
                      class="tw-stop-number"
                      type="button"
                      data-stop={n}
                      aria-label={`在地图定位：${stop.name}`}
                      title="在地图定位"
                    >
                      {n + 1}
                    </button>
                    <div>
                      <div class="tw-stop-meta">
                        <span>{stop.kind}</span>
                        <span>{stop.period}</span>
                      </div>
                      <h4>{stop.name}</h4>
                      <p>{stop.detail}</p>
                    </div>
                  </li>
                ))}
              </ol>
              <div class="tw-stay">
                <>
                  <span>今晚住哪</span>
                  <strong>{day.stay}</strong>
                </>
              </div>
              <div class="tw-legs">
                <>
                  <h4>分段导航与票务</h4>
                  <ul>
                    {day.legs.map((leg) => (
                      <li>
                        {googleRoute(leg.url) && (
                          <button
                            type="button"
                            class="tw-show-route"
                            data-map-leg={day.legs.indexOf(leg)}
                          >
                            在地图查看
                          </button>
                        )}
                        <a
                          href={leg.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {leg.label}
                          <span aria-hidden="true"> ↗</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <a
                    class="tw-preview"
                    href={day.previewUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Google Maps 地点顺序预览 ↗
                  </a>
                </>
              </div>
              <aside class="tw-culture">
                <>
                  <h4>{day.culture.title}</h4>
                  <p>{day.culture.body}</p>
                  <a
                    href={day.culture.source.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {day.culture.source.title} ↗
                  </a>
                </>
              </aside>
            </section>
          )),
        )
      }
    </div>
    <aside class="tw-map-column" aria-label="Google Maps 分段路线">
      <div class="tw-map-sticky">
        <div class="tw-map-heading">
          <strong data-map-title>D1 · 抵达与入住</strong><a
            data-map-external
            href={firstRoute.url}
            target="_blank"
            rel="noopener noreferrer">打开 Google Maps ↗</a
          >
        </div>
        <label class="tw-map-route-label" for="tw-map-route"
          >选择路线或地点</label
        >
        <select id="tw-map-route" data-map-route>
          <optgroup label="分段路线"
            >{
              first.days[0].legs.map(
                (leg, index) =>
                  googleRoute(leg.url) && (
                    <option value={`leg:${index}`}>{leg.label}</option>
                  ),
              )
            }</optgroup
          >
          <optgroup label="地点位置"
            >{
              first.days[0].stops.map((stop, index) => (
                <option value={`stop:${index}`}>
                  {index + 1}. {stop.name}
                </option>
              ))
            }</optgroup
          >
        </select>
        <div class="tw-map-wrap">
          <iframe
            data-tw-map
            class="tw-map"
            src={firstRoute.embedUrl}
            title={`Google Maps：${first.days[0].legs[0].label}`}
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen></iframe>
          <p class="tw-map-loading" data-map-loading hidden>
            正在载入 Google Maps…
          </p>
          <p class="tw-map-error" data-map-error hidden>
            地图载入较慢，可以用上方链接打开 Google Maps。
          </p>
        </div>
        <p class="tw-map-caption" data-map-caption>
          Google Maps按公共交通规划这一段；在Google
          Maps中核对出行日期、班次和换乘。课程、观景台和汤屋按实际预约时段安排。
        </p>
        <p class="tw-map-selection" data-map-selection aria-live="polite">
          {first.days[0].legs[0].label}
        </p>
      </div>
    </aside>
  </div>
  <noscript
    ><p class="tw-nojs">
      启用 JavaScript 可切换每日行程与地图；所有日期的导航链接也可在下方展开。
    </p></noscript
  >
  <details class="tw-all-links">
    <summary>展开两种出发日期的每日导航链接</summary>{
      plans.map((plan) => (
        <div>
          <>
            <h3>{plan.label}</h3>
            <ul>
              {plan.days.map((day) => (
                <li>
                  <strong>
                    D{day.id} · {day.date} · {day.name}
                  </strong>
                  <a
                    href={day.previewUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    地点预览 ↗
                  </a>
                  {day.legs.map((leg) => (
                    <a href={leg.url} target="_blank" rel="noopener noreferrer">
                      {leg.label} ↗
                    </a>
                  ))}
                </li>
              ))}
            </ul>
          </>
        </div>
      ))
    }
  </details>
  <section class="tw-budget" aria-labelledby="tw-budget-title">
    <div>
      <h3 id="tw-budget-title">算一算，这趟要花多少</h3><p>
        预算按每人计算，住宿填自己实际承担的金额。切换日期会载入规划预留；1
        港元按 NT$4.2 粗算。
      </p>
    </div>
    <div class="tw-budget-fields">
      <label
        >往返机票（HK$）<input
          data-budget="flight"
          type="number"
          min="0"
          step="100"
          value={first.budget.flight}
          inputmode="decimal"
        /></label
      >
      <label
        ><span data-hotel-label>{first.days.length - 1}晚住宿／人（NT$）</span
        ><input
          data-budget="hotel"
          type="number"
          min="0"
          step="500"
          value={first.budget.hotel}
          inputmode="decimal"
        /></label
      >
      <label
        ><span data-food-label>{first.days.length}天餐饮／人（NT$）</span><input
          data-budget="food"
          type="number"
          min="0"
          step="100"
          value={first.budget.food}
          inputmode="decimal"
        /></label
      >
      <label
        >额外开销（HK$）<input
          data-budget="extra"
          type="number"
          min="0"
          step="100"
          value="0"
          inputmode="decimal"
        /></label
      >
    </div>
    <div class="tw-budget-total">
      <p>
        另预留交通 NT$3,000、门票体验 NT$3,500、应急
        NT$1,500。计程车、接送与超出部分填入额外开销。这些是规划数值，房价和机票以订单报价为准。
      </p><output data-total aria-live="polite"
        >约 HK${
          Math.round(
            first.budget.flight +
              (first.budget.hotel + first.budget.food + TAIWAN_BUDGET_RESERVE) /
                4.2,
          ).toLocaleString("en-US")
        }／人</output
      >
    </div>
  </section>
</section>

<script>
  import { googleRoute, googlePlace } from "../lib/taiwan-maps";
  import type { TaiwanPlan } from "../data/taiwan-trip";
  const root = document.querySelector<HTMLElement>("[data-tw-planner]");
  if (root) {
    const budgetReserve = Number(root.dataset.budgetReserve);
    const plans: TaiwanPlan[] = JSON.parse(root.dataset.plans ?? "[]");
    let plan = plans[0];
    let day = plan.days[0];
    const q = <T extends Element>(selector: string) =>
      root.querySelector<T>(selector)!;
    const qa = <T extends Element>(selector: string) =>
      Array.from(root.querySelectorAll<T>(selector));
    const panel = () => q<HTMLElement>(`#tw-panel-${plan.id}-${day.id}`);
    const frame = q<HTMLIFrameElement>("[data-tw-map]");
    let loadTimer: ReturnType<typeof setTimeout> | undefined;
    function setMap(
      embedUrl: string,
      url: string,
      title: string,
      caption: string,
    ) {
      if (frame.src !== embedUrl) {
        clearTimeout(loadTimer);
        q<HTMLElement>("[data-map-loading]").hidden = false;
        q<HTMLElement>("[data-map-error]").hidden = true;
        loadTimer = setTimeout(() => {
          q<HTMLElement>("[data-map-loading]").hidden = true;
          q<HTMLElement>("[data-map-error]").hidden = false;
        }, 18000);
        frame.classList.add("is-loading");
        frame.setAttribute("aria-busy", "true");
        frame.src = embedUrl;
      }
      frame.title = `Google Maps：${title}`;
      q<HTMLAnchorElement>("[data-map-external]").href = url;
      q<HTMLElement>("[data-map-caption]").textContent = caption;
      q<HTMLElement>("[data-map-selection]").textContent = title;
    }
    function selectMap(value: string) {
      const [kind, rawIndex] = value.split(":");
      const index = Number(rawIndex);
      if (!Number.isInteger(index) || index < 0) return;
      let selected = false;
      if (kind === "leg") {
        const leg = day.legs[index];
        const route = leg && googleRoute(leg.url);
        if (!route) return;
        setMap(
          route.embedUrl,
          route.url,
          leg.label,
          `Google Maps 按${route.label}规划这一段。出行日期、班次和换乘方案请在Google Maps中核对；纪念馆、象山和渡轮另看开放公告，课程与汤屋按预约时段。`,
        );
        selected = true;
      } else if (kind === "stop") {
        const stop = day.stops[index];
        if (!stop) return;
        const place = googlePlace(stop);
        setMap(
          place.embedUrl,
          place.url,
          `${index + 1}. ${stop.name}`,
          "当前显示地点位置。需要查看实际走法时，选择上方的分段路线；入馆、步道开放和课程报到点按官方或订单信息确认。",
        );
        selected = true;
      }
      if (!selected) return;
      q<HTMLSelectElement>("[data-map-route]").value = value;
      panel()
        .querySelectorAll<HTMLElement>("[data-stop-row]")
        .forEach((row) =>
          row.classList.toggle(
            "is-active",
            kind === "stop" && Number(row.dataset.stopRow) === index,
          ),
        );
      panel()
        .querySelectorAll<HTMLButtonElement>("[data-map-leg]")
        .forEach((button) =>
          button.setAttribute(
            "aria-pressed",
            String(kind === "leg" && Number(button.dataset.mapLeg) === index),
          ),
        );
    }
    function loadDayMap() {
      const select = q<HTMLSelectElement>("[data-map-route]");
      const routeGroup = document.createElement("optgroup");
      routeGroup.label = "分段路线";
      day.legs.forEach((leg, index) => {
        if (googleRoute(leg.url))
          routeGroup.append(new Option(leg.label, `leg:${index}`));
      });
      const placeGroup = document.createElement("optgroup");
      placeGroup.label = "地点位置";
      day.stops.forEach((stop, index) =>
        placeGroup.append(
          new Option(`${index + 1}. ${stop.name}`, `stop:${index}`),
        ),
      );
      select.replaceChildren(routeGroup, placeGroup);
      selectMap(
        routeGroup.firstElementChild?.getAttribute("value") ?? "stop:0",
      );
    }
    frame.addEventListener("load", () => {
      frame.classList.remove("is-loading");
      frame.setAttribute("aria-busy", "false");
      clearTimeout(loadTimer);
      q<HTMLElement>("[data-map-loading]").hidden = true;
      q<HTMLElement>("[data-map-error]").hidden = true;
    });
    frame.addEventListener("error", () => {
      frame.setAttribute("aria-busy", "false");
      clearTimeout(loadTimer);
      q<HTMLElement>("[data-map-loading]").hidden = true;
      q<HTMLElement>("[data-map-error]").hidden = false;
    });
    q<HTMLSelectElement>("[data-map-route]").addEventListener(
      "change",
      (event) => selectMap((event.currentTarget as HTMLSelectElement).value),
    );
    function selectDay(id: number) {
      day = plan.days.find((item) => item.id === id) ?? plan.days[0];
      qa<HTMLButtonElement>(`[data-plan-rail="${plan.id}"] [data-day]`).forEach(
        (button) => {
          const active = Number(button.dataset.day) === day.id;
          button.setAttribute("aria-selected", String(active));
          button.tabIndex = active ? 0 : -1;
        },
      );
      qa<HTMLElement>("[data-panel-plan]").forEach(
        (item) =>
          (item.hidden =
            item.dataset.panelPlan !== plan.id ||
            Number(item.dataset.panelDay) !== day.id),
      );
      qa<HTMLElement>("[data-stop-row]").forEach((item) =>
        item.classList.remove("is-active"),
      );
      q<HTMLElement>("[data-map-title]").textContent =
        `D${day.id} · ${day.name}`;
      loadDayMap();
    }
    qa<HTMLButtonElement>("[data-day]").forEach((button) => {
      button.addEventListener("click", () =>
        selectDay(Number(button.dataset.day)),
      );
      button.addEventListener("keydown", (event) => {
        if (
          ![
            "ArrowLeft",
            "ArrowRight",
            "ArrowUp",
            "ArrowDown",
            "Home",
            "End",
          ].includes(event.key)
        )
          return;
        event.preventDefault();
        const buttons = qa<HTMLButtonElement>(
          `[data-plan-rail="${plan.id}"] [data-day]`,
        );
        const index = buttons.indexOf(button);
        const next =
          event.key === "Home"
            ? 0
            : event.key === "End"
              ? buttons.length - 1
              : (index +
                  (["ArrowRight", "ArrowDown"].includes(event.key)
                    ? 1
                    : buttons.length - 1)) %
                buttons.length;
        buttons[next].focus();
        selectDay(Number(buttons[next].dataset.day));
      });
    });
    function showMap(value: string) {
      selectMap(value);
      if (window.matchMedia("(max-width: 680px)").matches) {
        q<HTMLElement>("[data-workspace]").dataset.view = "map";
        qa<HTMLButtonElement>("button[data-view]").forEach((button) =>
          button.setAttribute(
            "aria-pressed",
            String(button.dataset.view === "map"),
          ),
        );
        q<HTMLElement>(".tw-mobile-view").scrollIntoView({
          block: "start",
          behavior: "instant",
        });
      }
    }
    qa<HTMLButtonElement>("[data-stop]").forEach((button) =>
      button.addEventListener("click", () =>
        showMap(`stop:${button.dataset.stop}`),
      ),
    );
    qa<HTMLButtonElement>("[data-map-leg]").forEach((button) =>
      button.addEventListener("click", () =>
        showMap(`leg:${button.dataset.mapLeg}`),
      ),
    );
    function updateBudget() {
      const value = (key: string) =>
        Math.max(
          0,
          Number(q<HTMLInputElement>(`[data-budget="${key}"]`).value) || 0,
        );
      const total =
        value("flight") +
        value("extra") +
        (value("hotel") + value("food") + budgetReserve) / 4.2;
      q<HTMLOutputElement>("[data-total]").textContent =
        `约 HK$${Math.round(total).toLocaleString("en-US")}／人`;
    }
    qa<HTMLInputElement>("[data-budget]").forEach((input) =>
      input.addEventListener("input", updateBudget),
    );
    qa<HTMLButtonElement>("[data-plan]").forEach((button) =>
      button.addEventListener("click", () => {
        const next = plans.find((item) => item.id === button.dataset.plan);
        if (!next || next.id === plan.id) return;
        plan = next;
        qa<HTMLButtonElement>("[data-plan]").forEach((item) =>
          item.setAttribute(
            "aria-pressed",
            String(item.dataset.plan === plan.id),
          ),
        );
        qa<HTMLElement>("[data-plan-rail]").forEach(
          (item) => (item.hidden = item.dataset.planRail !== plan.id),
        );
        q<HTMLElement>("[data-plan-summary]").textContent = plan.summary;
        q<HTMLElement>("[data-plan-range]").textContent = plan.range;
        q<HTMLElement>("[data-plan-nights]").textContent = plan.nights;
        q<HTMLElement>("[data-hotel-label]").textContent =
          `${plan.days.length - 1}晚住宿／人（NT$）`;
        q<HTMLElement>("[data-food-label]").textContent =
          `${plan.days.length}天餐饮／人（NT$）`;
        for (const key of ["flight", "hotel", "food"] as const)
          q<HTMLInputElement>(`[data-budget="${key}"]`).value = String(
            plan.budget[key],
          );
        q<HTMLInputElement>('[data-budget="extra"]').value = "0";
        updateBudget();
        selectDay(1);
      }),
    );
    qa<HTMLButtonElement>("button[data-view]").forEach((button) =>
      button.addEventListener("click", () => {
        q<HTMLElement>("[data-workspace]").dataset.view = button.dataset.view;
        qa<HTMLButtonElement>("button[data-view]").forEach((item) =>
          item.setAttribute("aria-pressed", String(item === button)),
        );
      }),
    );
    updateBudget();
    loadDayMap();
  }
</script>

<style is:global>
  .tw-planner {
    scroll-margin-top: 100px;
    --tw-accent: #a0442b;
    --tw-soft: color-mix(in srgb, var(--ink) 5%, var(--surface));
    color: var(--ink);
    margin: 2rem 0 3.5rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    overflow: clip;
    font-family: var(--font-body, sans-serif);
    font-size: 15px;
    line-height: 1.7;
  }
  .tw-planner :is(h2, h3, h4, p, ol, ul) {
    margin: 0;
  }
  .tw-planner :is(ol, ul) {
    padding: 0;
    list-style: none;
  }
  .tw-planner :is(li, li + li) {
    margin: 0;
    padding: 0;
  }
  .tw-planner :is(button, input, select) {
    font: inherit;
  }
  .tw-planner button {
    cursor: pointer;
    color: inherit;
  }
  .tw-planner :is(button, a, input, select, summary):focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .tw-planner [hidden] {
    display: none !important;
  }
  .tw-planner a {
    color: var(--accent);
    text-underline-offset: 4px;
  }
  .tw-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 28px 14px;
  }
  .tw-topbar h2 {
    border: 0;
    padding: 0;
    font-size: 26px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .tw-topbar p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 14px;
  }
  .tw-plan-switch {
    display: flex;
    flex-shrink: 0;
    padding: 4px;
    background: var(--tw-soft);
    border-radius: 9px;
  }
  .tw-plan-switch button,
  .tw-mobile-view button {
    min-height: 44px;
    border: 0;
    background: transparent;
    padding: 8px 13px;
    border-radius: 6px;
    font-size: 14px;
  }
  .tw-plan-switch button[aria-pressed="true"] {
    background: var(--ink);
    color: var(--surface);
  }
  .tw-plan-switch button:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .tw-trip-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
