---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getTranslations,
  localizePath,
  type Locale,
  locales,
} from "../../i18n/utils";

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = (Astro.currentLocale ?? "zh-CN") as Locale;
const t = getTranslations(locale);
---

<BaseLayout title={t.notFoundTitle}>
  <div class="content-container not-found">
    <h1>{t.notFoundHeading}</h1>
    <p>404</p>
    <a href={localizePath("/", locale)} class="button-primary">
      {t.notFoundBackHome}
    </a>
  </div>
</BaseLayout>

<style>
  .not-found {
    min-height: 55vh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding-block: 6rem;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.2;
  }
  p {
    margin: 1.5rem 0 2rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
</style>
