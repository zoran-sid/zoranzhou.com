---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import portrait from "../../../assets/images/zoran-portrait.webp";
import { editorial } from "../../../i18n/editorial";
import {
  locales,
  getTranslations,
  localizePath,
  type Locale,
} from "../../../i18n/utils";
import "../../../styles/collections.css";
export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = (Astro.currentLocale ?? "zh-CN") as Locale;
const c = editorial(locale);
const t = getTranslations(locale);
---

<BaseLayout title={c.about} description={c.aboutDeck}>
  <div class="page-container">
    <header class="page-intro about-intro">
      <div>
        <p class="eyebrow">ABOUT / ZORAN ZHOU</p><h1>
          {c.aboutTitle.split("\n").map((line) => <span>{line}</span>)}
        </h1><p>{c.aboutDeck}</p><a class="text-link" href="#contact"
          >{c.contact} ↗</a
        >
      </div><div class="about-portrait">
        <Image
          src={portrait}
          alt="Zoran Zhou"
          width={300}
          height={300}
          quality={90}
        /><span class="eyebrow">BUILD · OBSERVE · WRITE</span>
      </div>
    </header>
    <section class="about-story editorial-section">
      <div><p class="eyebrow">BACKGROUND</p><h2>{t.aboutHeadline}</h2></div><div
      >
        {t.aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}<p>
          {
            locale === "zh-CN"
              ? "工作之外，我喜欢阅读、摄影与跑步，也会把旅途中的观察和生活里的思考写在这里。"
              : "Outside work, I read, take photographs and run. This site also holds observations from my travels and thoughts from everyday life."
          }
        </p><a class="text-link" href={localizePath("/life", locale)}
          >{c.exploreLife} ↗</a
        >
      </div>
    </section>
    <section class="editorial-section">
      <header class="section-head">
        <div><p class="eyebrow">A WAY OF WORKING</p><h2>{c.approach}</h2></div>
      </header><div class="method-grid">
        {
          c.methodTitles.map((title, index) => (
            <article>
              <>
                <span class="eyebrow">0{index + 1}</span>
                <h3>{title}</h3>
                <p>{c.methodBody[index]}</p>
              </>
            </article>
          ))
        }
      </div>
    </section>
    <section class="editorial-section">
      <header class="section-head">
        <div><p class="eyebrow">FOCUS & PRACTICE</p><h2>{c.skills}</h2></div>
      </header><div class="expertise-list">
        {
          t.skillsGroups.map((group) => (
            <article>
              <>
                <h3>{group.category}</h3>
                <ul>
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
