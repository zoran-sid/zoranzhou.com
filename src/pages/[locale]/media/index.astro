---
import LifeNavigation from "../../../components/LifeNavigation.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CategoryTabs from "../../../components/media/CategoryTabs.astro";
import MediaCard from "../../../components/media/MediaCard.astro";
import {
  getTranslations,
  localizePath,
  type Locale,
  locales,
} from "../../../i18n/utils";
import mediaListSource from "../../../content/media.md?raw";
import { parseMediaList, type MediaCategory } from "../../../lib/media/list";
import "../../../styles/media.css";
export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = (Astro.currentLocale ?? "zh-CN") as Locale;
const zh = locale === "zh-CN";
const t = getTranslations(locale);
const allItems = parseMediaList(mediaListSource);
const categoryLabels: Record<MediaCategory, string> = {
  movies: t.mediaCategoryMovies,
  tv: t.mediaCategoryTV,
  books: t.mediaCategoryBooks,
  games: t.mediaCategoryGames,
};
const categories = [
  { key: "all", label: t.mediaAll, count: allItems.length },
  ...Object.entries(categoryLabels).map(([key, label]) => ({
    key,
    label,
    count: allItems.filter((item) => item.category === key).length,
  })),
];
const countTemplate = zh
  ? "显示 {shown} / {total} 部作品"
  : "Showing {shown} of {total} titles";
const jsonld = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: t.mediaTitle,
  description: t.mediaDescription,
  url: new URL(localizePath("/media", locale), Astro.site).href,
};
---

<BaseLayout
  title={t.mediaTitle}
  description={t.mediaDescription}
  jsonld={jsonld}
>
  <div class="page-container archive-page" data-media-browser>
    <header class="page-intro">
      <LifeNavigation /><h1>{t.mediaTitle}</h1>
      <p>
        {
          zh
            ? "看过的故事，读过的文字，和玩过的世界。"
            : "Stories watched, pages read, and worlds played through."
        }
      </p>
      <p class="media-order">
        {
          zh
            ? "按观看顺序收藏，最近看过的在前。"
            : "Collected in viewing order, with the most recently watched first."
        }
      </p>
    </header>
    <div data-media-controls hidden>
      <CategoryTabs
        categories={categories}
        activeCategory="all"
        label={zh ? "作品类型" : "Type of work"}
      />
      <div class="media-toolbar">
        <label class="media-search"
          >{zh ? "查找作品" : "Find a title"}<input
            id="media-search"
            type="search"
            placeholder={zh ? "片名、书名或作者" : "Title or author"}
            autocomplete="off"
            aria-controls="media-results"
          /></label
        >
        <p
          class="media-count"
          data-media-count
          data-template={countTemplate}
          role="status"
          aria-live="polite"
          aria-atomic="true"
        >
        </p>
      </div>
    </div>
    <noscript
      ><p class="media-order">
        {
          zh
            ? "全部作品按观看日期展示；可使用浏览器的页内查找。"
            : "All titles are listed below. Use your browser’s Find command to look for a title."
        }
      </p></noscript
    >
    <div class="media-grid" id="media-results">
      {allItems.map((item) => <MediaCard item={item} locale={locale} />)}
    </div>
    <p class="media-empty" data-media-empty hidden>
      {
        zh
          ? "没有找到匹配的作品，请换个关键词或类型。"
          : "No matching titles. Try another search or category."
      }
    </p>
    <button class="media-more" type="button" data-media-more hidden
      >{zh ? "再看一些" : "Show more"}</button
    >
  </div>
</BaseLayout>
<script>
  import { initMediaBrowser } from "../../../lib/media/browser";
  const root = document.querySelector<HTMLElement>("[data-media-browser]");
  if (root) initMediaBrowser(root);
</script>
