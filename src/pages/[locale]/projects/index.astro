---
import ArrowIcon from "../../../components/ArrowIcon.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArticleRow from "../../../components/ArticleRow.astro";
import { getCollection } from "astro:content";
import { getWriting, entryPath } from "../../../lib/writing";
import { isPublished } from "../../../lib/content-policy";
import { editorial } from "../../../i18n/editorial";
import { locales, localizePath, type Locale } from "../../../i18n/utils";
import "../../../styles/collections.css";
export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = (Astro.currentLocale ?? "zh-CN") as Locale;
const c = editorial(locale);
const projects = (await getCollection("projects"))
  .filter((entry) => isPublished(entry) && entry.data.lang === locale)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const writing = await getWriting(locale);
const practice = writing.filter((entry) =>
  ["openwrt-building", "minecraft-local-project", "building-blog"].includes(
    entry.data.translationKey ?? "",
  ),
);
const research = writing.filter((entry) => entry.collection === "research");
const statuses = {
  active: c.active,
  completed: c.completed,
  archived: c.archived,
};
---

<BaseLayout title={c.work} description={c.workDeck}
  ><div class="page-container">
    <header class="page-intro">
      <h1>
        {c.workTitle.split("\n").map((line) => <span>{line}</span>)}
      </h1><p>{c.workDeck}</p>
    </header>
    {
      projects.length > 0 && (
        <section class="editorial-section project-collection">
          {projects.map((entry) => (
            <article class="project-case">
              <div>
                <span class="status-label">{statuses[entry.data.status]}</span>
                <h2>
                  <a href={entryPath(entry)}>
                    {entry.data.title}{" "}
                    <span aria-hidden="true">
                      <ArrowIcon direction="up-right" />
                    </span>
                  </a>
                </h2>
                <p>{entry.data.description}</p>
                <div class="tech-list">
                  {entry.data.tech.map((tech) => (
                    <span>{tech}</span>
                  ))}
                </div>
              </div>
              <div class="project-case__links">
                <a class="text-link" href={entryPath(entry)}>
                  {locale === "zh-CN"
                    ? "阅读项目记录"
                    : "Read the project notes"}{" "}
                  <ArrowIcon direction="up-right" />
                </a>
                {entry.data.repo && (
                  <a
                    class="text-link"
                    href={entry.data.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {locale === "zh-CN" ? "项目仓库" : "Repository"}{" "}
                    <ArrowIcon direction="up-right" />
                  </a>
                )}
              </div>
            </article>
          ))}
        </section>
      )
    }
    <section class="builds-overview editorial-section">
      <article class="builds-feature">
        <h2>{locale === "zh-CN" ? "这个网站" : "This website"}</h2>
        <p>
          {
            locale === "zh-CN"
              ? "用 Markdown 记录，借助 Astro 构建，通过 GitHub 和 Cloudflare 发布。它也是我持续实践前端、整理内容和改进阅读体验的地方。"
              : "Written in Markdown, built with Astro, and published through GitHub and Cloudflare. This site is also where I practice frontend development and improve how I organise and share ideas."
          }
        </p>
        {
          practice.find(
            (entry) => entry.data.translationKey === "building-blog",
          ) && (
            <a
              class="text-link"
              href={entryPath(
                practice.find(
                  (entry) => entry.data.translationKey === "building-blog",
                )!,
              )}
            >
              {locale === "zh-CN" ? "早期搭建记录" : "Earlier building notes"}
              <span aria-hidden="true">
                <ArrowIcon direction="up-right" />
              </span>
            </a>
          )
        }
      </article>
      <div class="builds-records">
        <h2>{locale === "zh-CN" ? "更多实践记录" : "More from building"}</h2>
        {
          practice
            .filter((entry) => entry.data.translationKey !== "building-blog")
            .map((entry) => <ArticleRow entry={entry} locale={locale} />)
        }
      </div>
    </section>
    {
      research.length > 0 && (
        <section class="editorial-section">
          <>
            <header class="section-head">
              <div>
                <>
                  <h2>{c.notebook}</h2>
                </>
              </div>
            </header>
            <div class="writing-list">
              {research.map((entry) => (
                <ArticleRow entry={entry} locale={locale} />
              ))}
            </div>
          </>
        </section>
      )
    }
    <section class="editorial-section">
      <a class="lab-portal" href={localizePath("/lab", locale)}
        ><div>
          <h2>
            WEB3 LAB <span aria-hidden="true"
              ><ArrowIcon direction="up-right" /></span
            >
          </h2><p>
            {
              locale === "zh-CN"
                ? "正在学习 TypeScript。这里保存学习笔记，以及后续区块链与 Web3 项目的计划。"
                : "Currently learning TypeScript. A place for learning notes and plans for blockchain and Web3 projects."
            }
          </p>
        </div><span class="text-link"
          >{c.labLink} <ArrowIcon direction="right" /></span
        ></a
      >
    </section>
  </div></BaseLayout
>
