---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArticleRow from "../../../components/ArticleRow.astro";
import { getCollection } from "astro:content";
import { getWriting, entryPath } from "../../../lib/writing";
import { isPublished } from "../../../lib/content-policy";
import { editorial } from "../../../i18n/editorial";
import { locales, localizePath, type Locale } from "../../../i18n/utils";
import "../../../styles/collections.css";
export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = (Astro.currentLocale ?? "zh-CN") as Locale;
const c = editorial(locale);
const projects = (await getCollection("projects"))
  .filter((entry) => isPublished(entry) && entry.data.lang === locale)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const writing = await getWriting(locale);
const practice = writing.filter((entry) =>
  ["openwrt-building", "minecraft-local-project", "building-blog"].includes(
    entry.data.translationKey ?? "",
  ),
);
const research = writing.filter((entry) => entry.collection === "research");
const statuses = {
  active: c.active,
  completed: c.completed,
  archived: c.archived,
};
---

<BaseLayout title={c.work} description={c.workDeck}
  ><div class="page-container">
    <header class="page-intro">
      <p class="eyebrow">PRACTICE / {c.work}</p><h1>
        {c.workTitle.split("\n").map((line) => <span>{line}</span>)}
      </h1><p>{c.workDeck}</p>
    </header>
    {
      projects.length > 0 && (
        <section class="editorial-section project-collection">
          {projects.map((entry) => (
            <article class="project-case">
              <div>
                <span class="status-label">{statuses[entry.data.status]}</span>
                <h2>
                  <a href={entryPath(entry)}>
                    {entry.data.title} <span aria-hidden="true">↗</span>
                  </a>
                </h2>
                <p>{entry.data.description}</p>
                <div class="tech-list">
                  {entry.data.tech.map((tech) => (
                    <span>{tech}</span>
                  ))}
                </div>
              </div>
              <div class="project-case__links">
                <a class="text-link" href={entryPath(entry)}>
                  {locale === "zh-CN"
                    ? "阅读项目记录"
                    : "Read the project notes"}{" "}
                  ↗
                </a>
                {entry.data.repo && (
                  <a
                    class="text-link"
                    href={entry.data.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {locale === "zh-CN" ? "项目仓库" : "Repository"} ↗
                  </a>
                )}
              </div>
            </article>
          ))}
        </section>
      )
    }
    <section class="editorial-section">
      <header class="section-head">
        <div>
          <p class="eyebrow">BUILD & DOCUMENT</p><h2>
            {locale === "zh-CN" ? "动手实践的记录" : "Notes from building"}
          </h2>
        </div>
      </header><div class="writing-list">
        {practice.map((entry) => <ArticleRow entry={entry} locale={locale} />)}
      </div>
    </section>
    {
      research.length > 0 && (
        <section class="editorial-section">
          <>
            <header class="section-head">
              <div>
                <>
                  <p class="eyebrow">RESEARCH NOTES</p>
                  <h2>{c.notebook}</h2>
                </>
              </div>
            </header>
            <div class="writing-list">
              {research.map((entry) => (
                <ArticleRow entry={entry} locale={locale} />
              ))}
            </div>
          </>
        </section>
      )
    }
    <section class="editorial-section">
      <a class="lab-portal" href={localizePath("/lab", locale)}
        ><div>
          <p class="eyebrow">INDEPENDENT LAB</p><h2>
            WEB3 LAB <span aria-hidden="true">↗</span>
          </h2><p>{c.labDeck}</p>
        </div><span class="text-link">{c.labLink} →</span></a
      >
    </section>
  </div></BaseLayout
>
