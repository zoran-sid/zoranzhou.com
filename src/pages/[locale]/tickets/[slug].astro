---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LifeNavigation from "../../../components/LifeNavigation.astro";
import TicketFace from "../../../components/TicketFace.astro";
import Comments from "../../../components/Comments.astro";
import { localizePath } from "../../../i18n/utils";
import { getTickets } from "../../../lib/tickets";
import { linkedNote, displayTicketDate } from "../../../lib/ticket-model";
import { hasReadableBody } from "../../../lib/content-policy";
import { entryPath } from "../../../lib/writing";
import "../../../styles/tickets.css";
export async function getStaticPaths() {
  return (await getTickets()).map((ticket) => ({
    params: { locale: ticket.data.lang, slug: ticket.slug },
    props: { ticket },
  }));
}
interface Props {
  ticket: CollectionEntry<"tickets">;
}
const { ticket } = Astro.props;
const { title, date, photos, location, lang: locale } = ticket.data;
const zh = locale === "zh-CN";
const { Content } = await ticket.render();
const note = linkedNote(ticket.data.note, await getCollection("blog"));
const description = [title, displayTicketDate(date, locale), location]
  .filter(Boolean)
  .join(" · ");
---

<BaseLayout title={title} description={description} ogImage={photos[0]}>
  <div class="page-container">
    <div class="ticket-detail-nav"><LifeNavigation /></div>
    <article class="ticket-detail">
      <header class="ticket-detail__heading">
        <a class="ticket-text-link" href={localizePath("/tickets", locale)}
          >{zh ? "所有票根" : "All tickets"}</a
        >
        <TicketFace ticket={ticket} locale={locale} heading="h1" detailed />
      </header>
      {
        photos.length > 0 && (
          <div
            class="ticket-photos"
            class:list={{ "ticket-photos--single": photos.length === 1 }}
          >
            {photos.map((src, index) => (
              <figure>
                <a
                  href={src}
                  aria-label={
                    zh
                      ? `查看${title}的照片 ${index + 1} 原图`
                      : `View full photo ${index + 1} of ${title}`
                  }
                >
                  <img
                    src={src}
                    alt={
                      zh
                        ? `${title} · 照片 ${index + 1}`
                        : `${title} · photo ${index + 1}`
                    }
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </a>
              </figure>
            ))}
          </div>
        )
      }
      {
        hasReadableBody(ticket) && (
          <div class="prose article-prose ticket-story">
            <Content />
          </div>
        )
      }
      {
        note && (
          <aside class="ticket-note" aria-labelledby="ticket-note-title">
            <h2 id="ticket-note-title">
              {zh ? "那天的随记" : "A note from the day"}
            </h2>
            <a
              class="ticket-text-link"
              href={entryPath(note)}
              lang={note.data.lang}
            >
              {note.data.title}
            </a>
            {note.data.lang !== locale && (
              <span class="ticket-note__language">
                {note.data.lang === "zh-CN" ? "中文" : "English"}
              </span>
            )}
          </aside>
        )
      }
      <Comments />
    </article>
  </div>
</BaseLayout>
