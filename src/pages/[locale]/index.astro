---
import ArrowIcon from "../../components/ArrowIcon.astro";
import SectionAtmosphere from "../../components/SectionAtmosphere.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSection from "../../components/HeroSection.astro";
import ArticleRow from "../../components/ArticleRow.astro";
import LifeFeature from "../../components/LifeFeature.astro";
import { getCollection } from "astro:content";
import {
  getWriting,
  selectWriting,
  entryPath,
  displayDate,
} from "../../lib/writing";
import { writingFormat, isPublished } from "../../lib/content-policy";
import { readingTime } from "../../lib/utils";
import { editorial } from "../../i18n/editorial";
import { locales, localizePath, type Locale } from "../../i18n/utils";
import "../../styles/home.css";
export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = (Astro.currentLocale ?? "zh-CN") as Locale;
const c = editorial(locale);
const writing = await getWriting(locale);
const selected = selectWriting(writing, locale);
const recent = writing
  .filter((entry) => writingFormat(entry) === "note")
  .slice(0, 3);
const projects = (await getCollection("projects"))
  .filter((entry) => isPublished(entry) && entry.data.lang === locale)
  .slice(0, 2);
const jsonld = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "ZORAN ZHOU",
  url: new URL(localizePath("/", locale), Astro.site).href,
  description: c.intro,
  inLanguage: locale,
  author: { "@type": "Person", name: "Zoran Zhou" },
};
---

<BaseLayout description={c.intro} jsonld={jsonld}>
  <HeroSection />
  {
    recent.length > 0 && (
      <section
        class="editorial-section page-container recent-section"
        aria-labelledby="recent-title"
      >
        <>
          <header class="section-head">
            <>
              <div>
                <h2 id="recent-title">
                  {locale === "zh-CN" ? "最近的短笔记" : "Latest notes"}
                </h2>
              </div>
              <p class="section-aside">
                {locale === "zh-CN"
                  ? "一个问题，一点理解，都可以记下来。"
                  : "A question or a small discovery is enough."}
              </p>
            </>
          </header>
          <div class="writing-list">
            {recent.length ? (
              recent.map((entry) => (
                <ArticleRow entry={entry} locale={locale} updated />
              ))
            ) : (
              <p class="garden-empty">
                {locale === "zh-CN"
                  ? "短笔记将在这里慢慢积累。先看看已有的指南与随笔。"
                  : "Short notes will grow here over time. Start with the guides and essays already in the garden."}{" "}
                <a href={localizePath("/blog", locale)}>{c.allWriting}</a>
              </p>
            )}
          </div>
        </>
      </section>
    )
  }
  <section
    class="editorial-section page-container scene-section"
    id="selected"
    aria-labelledby="selected-title"
  >
    <SectionAtmosphere kind="lines" />
    <header class="section-head">
      <div>
        <h2 id="selected-title">
          {c.selected}
        </h2><p>{c.selectedDeck}</p>
      </div><a class="text-link" href={localizePath("/blog", locale)}
        >{c.allWriting}<span aria-hidden="true"
          ><ArrowIcon direction="up-right" /></span
        ></a
      >
    </header>
    <div class="selected-grid" data-motion="writing">
      {
        selected.map((entry, index) => (
          <article
            class:list={[
              "selected-story",
              { "selected-story--lead": index === 0 },
            ]}
          >
            <>
              <h3>
                <a href={entryPath(entry)}>{entry.data.title}</a>
              </h3>
              <p>{entry.data.description}</p>
              <div class="selected-story__bottom">
                <>
                  <span>
                    <time datetime={entry.data.date.toISOString()}>
                      {displayDate(entry.data.date, locale)}
                    </time>
                    <span class="meta-separator">·</span>
                    {readingTime(entry.body)} {c.reading}
                  </span>
                  <span class="story-arrow" aria-hidden="true">
                    <ArrowIcon direction="up-right" />
                  </span>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </section>
  {
    projects.length > 0 && (
      <section
        class="editorial-section page-container garden-projects scene-section"
        aria-labelledby="projects-heading"
      >
        <SectionAtmosphere kind="orbit" />
        <header class="section-head">
          <>
            <div>
              <>
                <h2 id="projects-heading">
                  {locale === "zh-CN" ? "实践中的想法" : "Ideas in practice"}
                </h2>
                <p>
                  {locale === "zh-CN"
                    ? "从学习记录，到可以回看的实践过程。"
                    : "From learning notes to a record of how things are built."}
                </p>
              </>
            </div>
            <a class="text-link" href={localizePath("/projects", locale)}>
              {locale === "zh-CN" ? "全部项目" : "All projects"}
            </a>
          </>
        </header>
        {projects.length ? (
          projects.map((entry) => (
            <article>
              <>
                <h3>
                  <a href={entryPath(entry)}>{entry.data.title}</a>
                </h3>
                <p>{entry.data.description}</p>
              </>
            </article>
          ))
        ) : (
          <p class="garden-empty">
            {locale === "zh-CN"
              ? "目前的实践记录在 Web3 Lab，正在从 TypeScript 基础开始积累。"
              : "Current practice lives in Web3 Lab, beginning with TypeScript fundamentals."}{" "}
            <a href={localizePath("/lab", locale)}>Web3 Lab</a>
          </p>
        )}
      </section>
    )
  }
  <LifeFeature locale={locale} />
</BaseLayout>
