---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { locales, localizePath, type Locale } from "../../../i18n/utils";
import { getWriting, entryPath, displayDate } from "../../../lib/writing";
import {
  isRouteVisible,
  normalizeRouteEntries,
} from "../../../lib/routes/content";
import { now } from "../../../data/now";
import "../../../styles/personal.css";
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = (Astro.currentLocale ?? "zh-CN") as Locale;
const zh = locale === "zh-CN";
const writing = (await getWriting(locale)).map((entry) => ({
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.date,
  href: entryPath(entry),
  kind: zh ? "写下的记录" : "Published writing",
}));
const routes = normalizeRouteEntries(
  await getCollection("routes", ({ data }) => isRouteVisible(data)),
)
  .filter((entry) => entry.data.lang === locale)
  .map((entry) => ({
    title: entry.data.title,
    description: entry.data.description || entry.data.location,
    date: entry.data.date,
    href: entryPath(entry),
    kind: zh ? "路上的记录" : "A journey",
  }));
const moments = [...writing, ...routes].sort(
  (a, b) => b.date.valueOf() - a.date.valueOf(),
);
const years = [...new Set(moments.map((moment) => moment.date.getFullYear()))];
---

<BaseLayout
  title="Now"
  description={zh
    ? "学习、工作与生活，沿着时间慢慢记录。"
    : "A running record of learning, work and life."}
>
  <div class="page-container personal-page">
    <header class="page-intro">
      <h1>Now</h1><p>
        {
          zh
            ? "学习、工作与生活，沿着时间慢慢记录。"
            : "Learning, work and life, one entry at a time."
        }
      </p>
    </header>
    <section class="now-present" aria-labelledby="now-current">
      <h2 id="now-current">{zh ? "此刻" : "At the moment"}</h2><div>
        <p>
          {
            zh
              ? "在香港教育大学攻读应用数据科学硕士，把之前的网络与安全实践带入新的学习。"
              : "Studying Applied Data Science at the Education University of Hong Kong, building on my experience in networks and security."
          }
        </p><p>{now[locale].body}</p><a
          class="text-link"
          href={localizePath("/lab", locale)}>Web3 Lab</a>
      </div>
    </section>
    <p class="timeline-caption">
      {
        zh
          ? "以下按文章发布与路线记录的日期排列。"
          : "Entries below follow the publication dates of my writing and the dates of my journeys."
      }
    </p>
    {
      years.map((year) => (
        <section class="timeline-year" aria-labelledby={`year-${year}`}>
          <>
            <h2 id={`year-${year}`}>{year}</h2>
            <ol class="moment-list">
              {moments
                .filter((moment) => moment.date.getFullYear() === year)
                .map((moment) => (
                  <li>
                    <article>
                      <div class="moment-meta">
                        <time datetime={moment.date.toISOString()}>
                          {displayDate(moment.date, locale)}
                        </time>
                        <span>{moment.kind}</span>
                      </div>
                      <h3>
                        <a href={moment.href}>{moment.title}</a>
                      </h3>
                      {moment.description && <p>{moment.description}</p>}
                    </article>
                  </li>
                ))}
            </ol>
          </>
        </section>
      ))
    }
  </div>
</BaseLayout>
