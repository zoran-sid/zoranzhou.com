---
import { isPublicData } from "../../../lib/content-policy";
import BlogPostLayout from "../../../layouts/BlogPostLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => isPublicData(data));
  return posts.map((post) => ({
    params: { locale: post.data.lang ?? "zh-CN", slug: post.slug },
    props: { entry: post },
  }));
}

const { entry } = Astro.props;
---

<BlogPostLayout
  entry={entry}
  variant={entry.slug === "taiwan-seven-days-2026" ? "itinerary" : "article"}
/>
