---
import WritingArchive from "../../../components/WritingArchive.astro";
import { getWriting } from "../../../lib/writing";
import { paginateEntries } from "../../../lib/pagination";
import { locales } from "../../../i18n/utils";
export async function getStaticPaths() {
  const entries = await getWriting();
  return locales.flatMap((locale) =>
    paginateEntries(
      entries.filter((entry) => entry.data.lang === locale),
      "/blog",
    ).map(({ param, ...props }) => ({
      params: { locale, page: param },
      props,
    })),
  );
}
---

<WritingArchive {...Astro.props} />
