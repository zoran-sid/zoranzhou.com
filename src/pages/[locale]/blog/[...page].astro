---
import WritingArchive from "../../../components/WritingArchive.astro";
import { getWriting } from "../../../lib/writing";
import { writingFormat } from "../../../lib/content-policy";
import { ARTICLE_PAGE_SIZE, paginateEntries } from "../../../lib/pagination";
import { locales } from "../../../i18n/utils";
export async function getStaticPaths() {
  // Notes are read as a continuous timeline; the writing index lists articles.
  const entries = (await getWriting()).filter(
    (entry) => writingFormat(entry) !== "note",
  );
  return locales.flatMap((locale) =>
    paginateEntries(
      entries.filter((entry) => entry.data.lang === locale),
      "/blog",
      ARTICLE_PAGE_SIZE,
    ).map(({ param, ...props }) => ({
      params: { locale, page: param },
      props,
    })),
  );
}
---

<WritingArchive {...Astro.props} />
