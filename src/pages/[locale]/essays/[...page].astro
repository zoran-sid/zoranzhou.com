---
import WritingArchive from "../../../components/WritingArchive.astro";
import { getWriting } from "../../../lib/writing";
import { paginateEntries } from "../../../lib/pagination";
import { getTranslations, locales, type Locale } from "../../../i18n/utils";
export async function getStaticPaths() {
  const entries = (await getWriting()).filter(
    (entry) => entry.collection === "essays",
  );
  return locales.flatMap((locale) =>
    paginateEntries(
      entries.filter((entry) => entry.data.lang === locale),
      "/essays",
    ).map(({ param, ...props }) => ({
      params: { locale, page: param },
      props,
    })),
  );
}
const t = getTranslations((Astro.currentLocale ?? "zh-CN") as Locale);
---

<WritingArchive
  {...Astro.props}
  category="life"
  title={t.essaysTitle}
  description={t.essaysDescription}
/>
