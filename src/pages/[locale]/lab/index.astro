---
import ArrowIcon from "../../../components/ArrowIcon.astro";
import { isPublicData } from "../../../lib/content-policy";
import { getCollection } from "astro:content";
import LabLayout from "../../../layouts/LabLayout.astro";
import { getLabTranslations } from "../../../i18n/lab";
import { getLabEntryPath, LAB_CURRENT_FOCUS_KEY } from "../../../lib/lab";
import { localizePath, locales, type Locale } from "../../../i18n/utils";
export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = (Astro.currentLocale ?? "zh-CN") as Locale;
const copy = getLabTranslations(locale),
  c = copy.home;
const entries = await getCollection(
  "lab",
  ({ data }) => isPublicData(data) && data.lang === locale,
);
const focus = entries.find(
  (entry) => entry.data.translationKey === LAB_CURRENT_FOCUS_KEY,
);
if (!focus) throw new Error(`Missing Lab focus: ${locale}`);
const plans = entries.filter(
  (entry) => entry.data.type === "build" && entry.data.status === "planned",
);
const security = entries.filter((entry) => entry.data.type === "security");
const alternatePaths = Object.fromEntries(
  locales.map((lang) => [lang, localizePath("/lab", lang)]),
);
const jsonld = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "WEB3 LAB",
  description: c.intro,
  url: new URL(localizePath("/lab", locale), Astro.site).href,
  inLanguage: locale,
  author: { "@type": "Person", name: "Zoran Zhou" },
};
---

<LabLayout
  description={c.intro}
  alternatePaths={alternatePaths}
  jsonld={jsonld}
>
  <section id="overview" class="lab-shell lab-hero">
    <div>
      <h1>
        {locale === "zh-CN" ? "从 TypeScript 开始" : "Starting with TypeScript"}
      </h1><p class="lab-hero__intro">{c.intro}</p><div
        class="lab-hero__actions"
      >
        <a class="lab-button lab-button--primary" href={getLabEntryPath(focus)}
          >{c.readFocus}<span aria-hidden="true"
            ><ArrowIcon direction="up-right" /></span
          ></a
        ><a class="lab-text-link" href="#learning"
          >{c.viewRoute} <ArrowIcon direction="down" /></a
        >
      </div>
    </div>
    <a class="lab-focus" href={getLabEntryPath(focus)}
      ><div class="lab-focus__top">
        <span>{c.current}</span><span class="lab-signal lab-signal--building"
          ><i></i>{c.learning}</span
        >
      </div><div class="lab-focus__sample" aria-hidden="true">
        <pre><code><span>type</span> LearningNote = &lbrace;
  topic: <span>string</span>;
  questions: <span>string</span>[];
  nextStep: <span>string</span>;
&rbrace;;</code></pre>
      </div><div class="lab-focus__bottom">
        <h2>
          TypeScript<span aria-hidden="true"
            ><ArrowIcon direction="up-right" /></span>
        </h2><p>{c.focusDeck}</p>
      </div></a
    >
  </section>
  <section id="learning" class="lab-shell lab-section">
    <header class="lab-section__header">
      <div>
        <h2>{c.routeTitle}</h2>
      </div><p>{c.routeDeck}</p>
    </header>
    <ol
      class="lab-roadmap"
      aria-label={locale === "zh-CN" ? "Web3 学习路线" : "Web3 learning path"}
    >
      {
        c.stages.map((stage, index) => (
          <li
            data-state={index === 0 ? "current" : "pending"}
            aria-current={index === 0 ? "step" : undefined}
          >
            <>
              <div class="lab-roadmap__index">
                <>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <span>{index === 0 ? c.learning : c.pending}</span>
                </>
              </div>
              <h3>{stage.tech}</h3>
              <strong>{stage.title}</strong>
              <p>{stage.outcome}</p>
            </>
          </li>
        ))
      }
    </ol>
  </section>
  <section id="builds" class="lab-shell lab-section">
    <header class="lab-section__header">
      <div>
        <h2>{c.buildTitle}</h2>
      </div><p>{c.buildDeck}</p>
    </header>
    {
      plans.map((entry) => (
        <article class="lab-project-plan">
          <>
            <div class="lab-project-plan__copy">
              <>
                <div class="lab-record-labels">
                  <>
                    <span>{copy.statusLabels[entry.data.status]}</span>
                    <span>
                      {copy.verificationLabels[entry.data.verificationStatus]}
                    </span>
                  </>
                </div>
                <h3>
                  <a href={getLabEntryPath(entry)}>{entry.data.title}</a>
                </h3>
                <p>{entry.data.description}</p>
                <a class="lab-text-link" href={getLabEntryPath(entry)}>
                  {c.buildLink} <ArrowIcon direction="up-right" />
                </a>
              </>
            </div>
            <div class="lab-project-plan__stack">
              <>
                <dl>
                  {entry.data.candidateStack.map((group) => (
                    <div>
                      <dt>{copy.stack.groups[group.group]}</dt>
                      <dd>{group.items.join(" + ")}</dd>
                    </div>
                  ))}
                </dl>
                <small>{c.stackNote}</small>
              </>
            </div>
          </>
        </article>
      ))
    }
  </section>
  <section id="security" class="lab-shell lab-section">
    <header class="lab-section__header">
      <div>
        <h2>{c.securityTitle}</h2>
      </div><p>{c.securityDeck}</p>
    </header><div class="lab-note-list">
      {
        security.map((entry) => (
          <article>
            <>
              <div class="lab-record-labels">
                <span>
                  {copy.verificationLabels[entry.data.verificationStatus]}
                </span>
              </div>
              <h3>
                <a href={getLabEntryPath(entry)}>
                  {entry.data.title}
                  <span aria-hidden="true">
                    <ArrowIcon direction="up-right" />
                  </span>
                </a>
              </h3>
              <p>{entry.data.description}</p>
              <a class="lab-text-link" href={getLabEntryPath(entry)}>
                {c.securityLink} <ArrowIcon direction="right" />
              </a>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section id="about" class="lab-shell lab-section lab-about">
    <div>
      <h2>{c.aboutTitle}</h2>
    </div><div>
      <p>{c.aboutDeck}</p><div class="lab-domains">
        {c.domains.map((domain) => <span>{domain}</span>)}
      </div><p class="lab-about__boundary">{c.boundary}</p>
    </div>
  </section>
</LabLayout>
