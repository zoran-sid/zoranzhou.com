---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LifeNavigation from "../../../components/LifeNavigation.astro";
import LifeFeature from "../../../components/LifeFeature.astro";
import HomeActivities from "../../../components/HomeActivities.astro";
import LibraryShelf from "../../../components/LibraryShelf.astro";
import TicketShelf from "../../../components/TicketShelf.astro";
import { editorial } from "../../../i18n/editorial";
import { locales, type Locale } from "../../../i18n/utils";
import "../../../styles/home.css";
export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = (Astro.currentLocale ?? "zh-CN") as Locale;
const c = editorial(locale);
---

<BaseLayout title={c.life} description={c.lifeDeck}>
  <div class="page-container">
    <header class="page-intro">
      <LifeNavigation /><h1>
        {c.lifeTitle.split("\n").map((line) => <span>{line}</span>)}
      </h1><p>{c.lifeDeck}</p>
    </header>
  </div>
  <LifeFeature locale={locale} overview />
  <TicketShelf locale={locale} />
  <HomeActivities locale={locale} />
  <LibraryShelf locale={locale} />
</BaseLayout>
