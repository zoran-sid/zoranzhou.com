---
import BaseLayout from "./BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { getTranslations, localizePath, type Locale } from "../i18n/utils";
import { editorial } from "../i18n/editorial";
import { readingTime } from "../lib/utils";
import { getWriting, entryPath, displayDate } from "../lib/writing";
import {
  isPublished,
  hasReadableBody,
  writingCategory,
} from "../lib/content-policy";
type ContentCollection = "blog" | "essays" | "research" | "projects" | "photos";
interface Props {
  entry: CollectionEntry<ContentCollection>;
}
const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const locale = (Astro.currentLocale ?? "zh-CN") as Locale;
const t = getTranslations(locale);
const c = editorial(locale);
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
const allWriting = await getWriting(locale);
const sameCategory = (candidate: (typeof allWriting)[number]) =>
  writingCategory(candidate) === writingCategory(entry);
const related = allWriting
  .filter((candidate) => entryPath(candidate) !== entryPath(entry))
  .map((candidate) => ({
    entry: candidate,
    score:
      candidate.data.tags.filter((tag) =>
        entry.data.tags.some((t) => t.toLowerCase() === tag.toLowerCase()),
      ).length *
        3 +
      (sameCategory(candidate) ? 1 : 0),
  }))
  .filter((item) => item.score > 0)
  .sort(
    (a, b) =>
      b.score - a.score ||
      b.entry.data.date.valueOf() - a.entry.data.date.valueOf(),
  )
  .slice(0, 3)
  .map((item) => item.entry);
const allInCollection = (
  await getCollection(entry.collection as ContentCollection)
)
  .filter(
    (candidate) =>
      isPublished(candidate) &&
      candidate.data.lang === locale &&
      hasReadableBody(candidate),
  )
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const index = allInCollection.findIndex(
  (candidate) => candidate.slug === entry.slug,
);
const older = index >= 0 ? allInCollection[index + 1] : undefined;
const newer = index > 0 ? allInCollection[index - 1] : undefined;
const labels = {
  blog: c.writing,
  essays: c.notes,
  research: c.notebook,
  projects: c.work,
  photos: c.photos,
};
const collectionPath =
  entry.collection === "projects"
    ? "/projects"
    : entry.collection === "photos"
      ? "/photos"
      : "/blog";
const jsonld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      headline: entry.data.title,
      description: entry.data.description ?? "",
      author: { "@type": "Person", name: entry.data.author },
      datePublished: entry.data.date.toISOString(),
      dateModified: (entry.data.updated ?? entry.data.date).toISOString(),
      url: new URL(entryPath(entry), Astro.site).href,
      inLanguage: locale,
      ...(entry.data.cover?.src
        ? { image: new URL(entry.data.cover.src, Astro.site).href }
        : {}),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "ZORAN ZHOU",
          item: new URL(localizePath("/", locale), Astro.site).href,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: labels[entry.collection],
          item: new URL(localizePath(collectionPath, locale), Astro.site).href,
        },
        { "@type": "ListItem", position: 3, name: entry.data.title },
      ],
    },
  ],
};
let parent = "";
const toc = tocItems.map((h) => {
  if (h.depth === 2) parent = h.slug;
  return { ...h, parent };
});
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.cover?.src}
  article
  jsonld={jsonld}
>
  {Astro.slots.has("pre-content") && <slot name="pre-content" />}
  <div class="article-shell" data-reading-category={writingCategory(entry)}>
    <article
      class="article-main"
      data-article-content
      data-copy-label={locale === "zh-CN" ? "复制代码" : "Copy code"}
      data-copied-label={locale === "zh-CN" ? "已复制" : "Copied"}
      data-copy-failed={locale === "zh-CN"
        ? "复制失败，请手动选择"
        : "Select code to copy"}
    >
      <header class="article-header mb-10">
        <nav
          class="article-breadcrumb"
          aria-label={locale === "zh-CN" ? "当前位置" : "Breadcrumb"}
        >
          <a href={localizePath("/", locale)}>ZORAN ZHOU</a><span
            aria-hidden="true">/</span
          ><a href={localizePath(collectionPath, locale)}
            >{labels[entry.collection]}</a
          >
        </nav>
        <h1 class="article-title">{entry.data.title}</h1>
        {
          entry.data.description && (
            <p class="article-description mt-5">{entry.data.description}</p>
          )
        }
        <div
          class="article-meta mt-6 flex flex-wrap items-center gap-x-3 gap-y-2"
        >
          <span>{entry.data.author}</span><time
            datetime={entry.data.date.toISOString()}
            >{displayDate(entry.data.date, locale)}</time
          >{
            hasReadableBody(entry) && (
              <span>
                · {readingTime(entry.body)} {c.reading}
              </span>
            )
          }{
            entry.data.updated && (
              <span>
                · {c.updated}{" "}
                <time datetime={entry.data.updated.toISOString()}>
                  {displayDate(entry.data.updated, locale)}
                </time>
              </span>
            )
          }
        </div>
        {
          entry.data.tags.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-2">
              {entry.data.tags.map((tag) => (
                <a
                  class="article-tag rounded-sm"
                  href={localizePath(
                    `/tags/${tag.toLowerCase().replace(/\s+/g, "-")}`,
                    locale,
                  )}
                >
                  {tag}
                </a>
              ))}
            </div>
          )
        }
        {
          entry.collection === "projects" && (
            <div class="article-context">
              <span>
                {
                  {
                    active: c.active,
                    completed: c.completed,
                    archived: c.archived,
                  }[entry.data.status]
                }
              </span>
              {entry.data.repo && (
                <a
                  href={entry.data.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {locale === "zh-CN" ? "项目仓库" : "Repository"} ↗
                </a>
              )}
              {entry.data.demo && (
                <a
                  href={entry.data.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {locale === "zh-CN" ? "演示" : "Demo"} ↗
                </a>
              )}
            </div>
          )
        }
        {
          toc.length > 0 && (
            <details class="article-mobile-toc mt-7 xl:hidden">
              <>
                <summary>
                  {t.postTableOfContents}
                  <span aria-hidden="true">⌄</span>
                </summary>
                <ul>
                  {toc.map((h) => (
                    <li class={h.depth === 3 ? "toc-depth-3" : ""}>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ul>
              </>
            </details>
          )
        }
      </header>
      <div class="prose article-prose">
        {
          hasReadableBody(entry) ? (
            <Content />
          ) : (
            <div class="article-empty">
              <>
                <p>
                  {locale === "zh-CN"
                    ? "这篇手记还在整理中。先从其他文章开始吧。"
                    : "These notes are still being prepared. In the meantime, explore the other writing."}
                </p>
                <a href={localizePath("/blog", locale)}>{c.allWriting}</a>
              </>
            </div>
          )
        }
      </div>
      <footer class="article-footer mt-16 border-t pt-8">
        {
          related.length > 0 && (
            <div>
              <>
                <p class="eyebrow">CONTINUE READING</p>
                <h2 class="text-2xl mt-3 mb-6">{c.next}</h2>
                <div class="related-reading">
                  {related.map((candidate) => (
                    <a href={entryPath(candidate)}>
                      <span>{candidate.data.title}</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </div>
              </>
            </div>
          )
        }
        {
          (older || newer) && (
            <nav
              class="article-adjacent"
              aria-label={locale === "zh-CN" ? "相邻文章" : "Adjacent writing"}
            >
              {older ? (
                <a href={entryPath(older)}>
                  <small>← {t.postPrevious}</small>
                  <span>{older.data.title}</span>
                </a>
              ) : (
                <span />
              )}
              {newer ? (
                <a href={entryPath(newer)}>
                  <small>{t.postNext} →</small>
                  <span>{newer.data.title}</span>
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }
        <a class="text-link" href={localizePath(collectionPath, locale)}
          >← {entry.collection === "projects" ? c.work : c.backWriting}</a
        >
      </footer>
    </article>
    {
      toc.length > 0 && (
        <aside class="article-toc hidden xl:block">
          <nav aria-label={t.postTableOfContents}>
            <>
              <p>{t.postTableOfContents}</p>
              <ol>
                {toc.map((h) => (
                  <li
                    class={h.depth === 3 ? "toc-depth-3" : ""}
                    data-toc-parent={h.parent}
                  >
                    <a href={`#${h.slug}`} data-toc-link={h.slug}>
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </>
          </nav>
        </aside>
      )
    }
  </div>
  <script>
    const article = document.querySelector<HTMLElement>(
      "[data-article-content]",
    );
    article?.querySelectorAll("pre").forEach((pre) => {
      if (pre.querySelector(".code-copy-button")) return;
      const button = document.createElement("button");
      button.type = "button";
      button.className = "code-copy-button";
      button.textContent = article.dataset.copyLabel ?? "Copy code";
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(
            pre.querySelector("code")?.textContent ?? "",
          );
          button.textContent = article.dataset.copiedLabel ?? "Copied";
          button.classList.add("copied");
        } catch {
          button.textContent =
            article.dataset.copyFailed ?? "Select code to copy";
        }
        setTimeout(() => {
          button.textContent = article.dataset.copyLabel ?? "Copy code";
          button.classList.remove("copied");
        }, 1800);
      });
      pre.appendChild(button);
    });
    const headings = [
      ...(article?.querySelectorAll<HTMLElement>(
        ".article-prose h2[id],.article-prose h3[id]",
      ) ?? []),
    ];
    const toc = document.querySelector<HTMLElement>(".article-toc");
    const links = [
      ...document.querySelectorAll<HTMLAnchorElement>(
        ".article-toc a[data-toc-link]",
      ),
    ];
    const visible = new Set<Element>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) visible.add(entry.target);
          else visible.delete(entry.target);
        });
        const active = headings.find((heading) => visible.has(heading));
        if (!active) return;
        links.forEach((link) => {
          const current = link.dataset.tocLink === active.id;
          link.classList.toggle("active", current);
          if (current) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        });
        const currentLink = links.find(
          (link) => link.dataset.tocLink === active.id,
        );
        const parent = currentLink?.parentElement?.dataset.tocParent;
        toc
          ?.querySelectorAll<HTMLElement>(".toc-depth-3")
          .forEach((item) =>
            item.classList.toggle(
              "is-expanded",
              item.dataset.tocParent === parent,
            ),
          );
        // Scroll only the TOC container. scrollIntoView here can pull the article itself.
        if (currentLink && toc) {
          const itemRect = currentLink.getBoundingClientRect();
          const rect = toc.getBoundingClientRect();
          if (itemRect.bottom > rect.bottom)
            toc.scrollTop += itemRect.bottom - rect.bottom + 12;
          else if (itemRect.top < rect.top)
            toc.scrollTop -= rect.top - itemRect.top + 12;
        }
      },
      { rootMargin: "-12% 0px -58% 0px", threshold: 0 },
    );
    if (toc) toc.classList.add("toc-enhanced");
    headings.forEach((heading) => observer.observe(heading));
  </script>
</BaseLayout>
