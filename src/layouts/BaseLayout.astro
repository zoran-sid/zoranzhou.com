---
import "../styles/global.css";
import mapStylesUrl from "../styles/maps.css?url";
import { resolveAlternatePaths } from "../lib/translations";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import ThemeScript from "../components/ThemeScript.astro";
import Navigation from "../components/Navigation.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  getTranslations,
  type Locale,
  locales,
  hreflangMap,
  localizePath,
} from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  article?: boolean;
  jsonld?: Record<string, unknown>;
  alternatePaths?: Partial<Record<Locale, string>>;
  mapStyles?: boolean;
}

const {
  title,
  description,
  ogImage,
  article = false,
  jsonld,
  alternatePaths,
  mapStyles = false,
} = Astro.props;

const locale = (Astro.currentLocale ?? "zh-CN") as Locale;
const t = getTranslations(locale);

const pageTitle = title ? `${title} | ZORAN ZHOU` : "ZORAN ZHOU";
const pageDescription = description ?? t.siteDescription;

// Current page path used for canonical and alternate URLs.
const canonicalPath = Astro.url.pathname;
const pathWithoutLocale =
  canonicalPath.replace(/^\/(?:zh-CN|en)(?=\/|$)/, "") || "/";
const safeAlternatePaths =
  alternatePaths ?? (await resolveAlternatePaths(canonicalPath, locale));
const otherLocale: Locale = locale === "zh-CN" ? "en" : "zh-CN";
const fallbackSection = pathWithoutLocale.split("/").filter(Boolean)[0] ?? "";
const alternateHref =
  safeAlternatePaths[otherLocale] ??
  localizePath(`/${fallbackSection}`, otherLocale);
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={new URL(canonicalPath, Astro.site)} />

    <!-- hreflang -->
    {
      locales.map((altLocale) => {
        const altPath = safeAlternatePaths[altLocale];
        if (!altPath) return null;
        return (
          <link
            rel="alternate"
            hreflang={hreflangMap[altLocale]}
            href={new URL(altPath, Astro.site).href}
          />
        );
      })
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL("/", Astro.site).href}
    />

    <!-- OpenGraph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={new URL(canonicalPath, Astro.site)} />
    <meta
      property="og:locale"
      content={locale === "zh-CN" ? "zh_Hans" : "en"}
    />
    {
      ogImage && (
        <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
      )
    }
    <meta property="og:site_name" content="ZORAN ZHOU" />

    <!-- Twitter -->
    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {
      ogImage && (
        <meta
          name="twitter:image"
          content={new URL(ogImage, Astro.site).href}
        />
      )
    }

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="ZORAN ZHOU RSS"
      href={localizePath("/rss.xml", locale)}
    />

    <!-- JSON-LD Structured Data -->
    {
      jsonld && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(jsonld).replace(/</g, "\\u003c")}
        />
      )
    }

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {mapStyles && <link rel="stylesheet" href="/styles/maplibre-gl.css" />}
    {mapStyles && <link rel="stylesheet" href="/styles/map-custom.css" />}
    {mapStyles && <link rel="stylesheet" href={mapStylesUrl} />}

    <ThemeScript />
  </head>
  <body class="site-body">
    <a class="skip-link" href="#main-content"
      >{locale === "zh-CN" ? "跳到主要内容" : "Skip to content"}</a
    >
    {
      article && (
        <div id="progress-bar" class="scroll-progress" aria-hidden="true" />
      )
    }
    <Navigation alternateHref={alternateHref} />
    <main id="main-content" class="site-main" tabindex="-1"><slot /></main>
    <SiteFooter />
    <button
      id="back-to-top"
      class="back-to-top"
      aria-label={locale === "zh-CN" ? "回到顶部" : "Back to top"}>↑</button
    >
    <script>
      const bar = document.getElementById("progress-bar");
      const back = document.getElementById("back-to-top");
      let frame = 0;
      function update() {
        const total = document.documentElement.scrollHeight - innerHeight;
        if (bar)
          bar.style.transform = `scaleX(${total > 0 ? scrollY / total : 0})`;
        back?.classList.toggle("visible", scrollY > 600);
        frame = 0;
      }
      window.addEventListener(
        "scroll",
        () => {
          if (!frame) frame = requestAnimationFrame(update);
        },
        { passive: true },
      );
      back?.addEventListener("click", () =>
        window.scrollTo({
          top: 0,
          behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "instant"
            : "smooth",
        }),
      );
      update();
    </script>
  </body>
</html>
