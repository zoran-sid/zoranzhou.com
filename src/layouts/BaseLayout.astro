---
import ScrollAtmosphere from "../components/ScrollAtmosphere.astro";
import ArrowIcon from "../components/ArrowIcon.astro";
import "../styles/global.css";
import mapStylesUrl from "../styles/maps.css?url";
import { resolveAlternatePaths } from "../lib/translations";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import ThemeScript from "../components/ThemeScript.astro";
import Navigation from "../components/Navigation.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  getTranslations,
  type Locale,
  locales,
  hreflangMap,
  localizePath,
} from "../i18n/utils";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  article?: boolean;
  jsonld?: Record<string, unknown>;
  alternatePaths?: Partial<Record<Locale, string>>;
  mapStyles?: boolean;
}

const {
  title,
  description,
  ogImage,
  article = false,
  jsonld,
  alternatePaths,
  mapStyles = false,
} = Astro.props;

const locale = (Astro.currentLocale ?? "zh-CN") as Locale;
const t = getTranslations(locale);

const pageTitle = title ? `${title} | ZORAN ZHOU` : "ZORAN ZHOU";
const pageDescription = description ?? t.siteDescription;

// Current page path used for canonical and alternate URLs.
const canonicalPath = Astro.url.pathname;
const pathWithoutLocale =
  canonicalPath.replace(/^\/(?:zh-CN|en)(?=\/|$)/, "") || "/";
const safeAlternatePaths =
  alternatePaths ?? (await resolveAlternatePaths(canonicalPath, locale));
const otherLocale: Locale = locale === "zh-CN" ? "en" : "zh-CN";
const fallbackSection = pathWithoutLocale.split("/").filter(Boolean)[0] ?? "";
const alternateHref =
  safeAlternatePaths[otherLocale] ??
  localizePath(`/${fallbackSection}`, otherLocale);
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={new URL(canonicalPath, Astro.site)} />

    <!-- hreflang -->
    {
      locales.map((altLocale) => {
        const altPath = safeAlternatePaths[altLocale];
        if (!altPath) return null;
        return (
          <link
            rel="alternate"
            hreflang={hreflangMap[altLocale]}
            href={new URL(altPath, Astro.site).href}
          />
        );
      })
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL("/", Astro.site).href}
    />

    <!-- OpenGraph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={new URL(canonicalPath, Astro.site)} />
    <meta
      property="og:locale"
      content={locale === "zh-CN" ? "zh_Hans" : "en"}
    />
    {
      ogImage && (
        <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
      )
    }
    <meta property="og:site_name" content="ZORAN ZHOU" />

    <!-- Twitter -->
    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {
      ogImage && (
        <meta
          name="twitter:image"
          content={new URL(ogImage, Astro.site).href}
        />
      )
    }

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="ZORAN ZHOU RSS"
      href={localizePath("/rss.xml", locale)}
    />

    <!-- JSON-LD Structured Data -->
    {
      jsonld && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(jsonld).replace(/</g, "\\u003c")}
        />
      )
    }

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {mapStyles && <link rel="stylesheet" href="/styles/maplibre-gl.css" />}
    {mapStyles && <link rel="stylesheet" href="/styles/map-custom.css" />}
    {mapStyles && <link rel="stylesheet" href={mapStylesUrl} />}

    <ThemeScript />
  </head>
  <body class="site-body">
    <ScrollAtmosphere />
    <a class="skip-link" href="#main-content"
      >{locale === "zh-CN" ? "跳到主要内容" : "Skip to content"}</a
    >
    {
      article && (
        <div id="progress-bar" class="scroll-progress" aria-hidden="true" />
      )
    }
    <Navigation alternateHref={alternateHref} />
    <main id="main-content" class="site-main" tabindex="-1"><slot /></main>
    <SiteFooter />
    <button
      id="back-to-top"
      class="back-to-top"
      aria-label={locale === "zh-CN" ? "回到顶部" : "Back to top"}
      style="--scroll-progress: 0; --comet-angle: 0deg"
      ><svg
        class="back-to-top-orbit"
        viewBox="0 0 72 72"
        aria-hidden="true"
        focusable="false"
      >
        <path class="back-to-top-orbit__track" d="M 5 36 A 31 31 0 0 1 67 36"
        ></path>
        <path class="back-to-top-orbit__progress" d="M 5 36 A 31 31 0 0 1 67 36"
        ></path>
        <g class="back-to-top-orbit__comet">
          <line x1="0" y1="2.5" x2="0" y2="5"></line>
          <circle cx="0" cy="0" r="2.2"></circle>
        </g>
      </svg><span class="back-to-top__icon"><ArrowIcon direction="up" /></span
      ></button
    >
    <script>
      import { scrollProgress } from "../lib/scroll-atmosphere";
      const bar = document.getElementById("progress-bar");
      const back = document.getElementById("back-to-top");
      const comet = back?.querySelector<SVGGElement>(
        ".back-to-top-orbit__comet",
      );
      let frame = 0;
      function update() {
        frame = 0;
        const progress = scrollProgress(
          scrollY,
          document.documentElement.scrollHeight,
          innerHeight,
        );
        if (bar) bar.style.transform = `scaleX(${progress})`;
        back?.style.setProperty("--scroll-progress", progress.toFixed(4));
        if (back) {
          const angle = Math.PI * (1 - progress);
          const x = 36 + 31 * Math.cos(angle);
          const y = 36 - 31 * Math.sin(angle);
          const radialRotation =
            (Math.atan2(-Math.sin(angle), Math.cos(angle)) * 180) / Math.PI +
            90;
          comet?.setAttribute(
            "transform",
            `translate(${x.toFixed(2)} ${y.toFixed(2)}) rotate(${radialRotation.toFixed(2)})`,
          );
        }
        back?.classList.toggle("visible", scrollY > 600);
      }
      function queueUpdate() {
        if (!frame) frame = requestAnimationFrame(update);
      }
      window.addEventListener("scroll", queueUpdate, { passive: true });
      window.addEventListener("resize", queueUpdate, { passive: true });
      window.addEventListener("pageshow", queueUpdate);
      document.addEventListener(
        "astro:before-swap",
        () => {
          cancelAnimationFrame(frame);
          window.removeEventListener("scroll", queueUpdate);
          window.removeEventListener("resize", queueUpdate);
          window.removeEventListener("pageshow", queueUpdate);
        },
        { once: true },
      );
      back?.addEventListener("click", () =>
        window.scrollTo({
          top: 0,
          behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "instant"
            : "smooth",
        }),
      );
      update();
    </script>
  </body>
</html>
