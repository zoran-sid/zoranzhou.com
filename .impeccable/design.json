      "css": ".ds-label{display:grid;gap:8px;color:var(--ink,#25314a);font:14px sans-serif}.ds-input{color:var(--ink,#25314a);background:var(--surface,#fff);border:1px solid var(--line-strong,#25314a38);border-radius:4px;padding:12px;font:16px sans-serif;min-height:44px}.ds-input:hover{border-color:var(--accent,#3e50a0)}.ds-input:focus-visible{outline:2px solid var(--accent,#3e50a0);outline-offset:3px}"
    },
