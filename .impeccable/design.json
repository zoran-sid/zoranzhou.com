      "css": ".ds-button{background:var(--accent,#3e50a0);color:var(--accent-ink,#fff);border:1px solid var(--accent,#3e50a0);border-radius:4px;min-height:3.1rem;padding:.8rem 1.3rem;font:500 .875rem sans-serif}.ds-button:hover{background:var(--ink,#25314a);border-color:var(--ink,#25314a)}.ds-button:focus-visible{outline:2px solid var(--accent,#3e50a0);outline-offset:5px}"
